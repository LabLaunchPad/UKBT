# Sentry (optional — only set in production environment)
SENTRY_DSN=

# TinaCMS Cloud (admin UI + schema indexing). Client ID is a public
# identifier; the token is SECRET — set it in the local .env (gitignored),
# GitHub Actions secrets (CI), and the Cloudflare Workers Builds environment.
# Never commit TINA_TOKEN or paste it into chat/docs/issues.
#
# tina/config.ts falls back to TINA_CLIENT_ID if PUBLIC_TINA_CLIENT_ID is
# not set (Tina's own docs use that name). PUBLIC_ prefix follows Astro
# convention — both names refer to the same value.
PUBLIC_TINA_CLIENT_ID=fe5da197-2c26-4071-9d72-e8216d5b53d6
TINA_TOKEN=
TINA_BRANCH=main
# Search is disabled by design — build uses --skip-search-index
# (package.json:18, ci.yml:272). No TINA_SEARCH_TOKEN needed.
# See tina/config.ts search block and docs/tina-audit/CMS_TRUST_MODEL.md.
# Tina admin origin allowlist (see @tinacms/astro dist/middleware.js adminOrigins() — path versioned, line numbers rot).
# Comma-separated origins allowed to embed /admin. Leave empty for same-origin; set when preview/production origins differ.
# Example: PUBLIC_TINA_ADMIN_ORIGIN=https://app.tina.io,https://ukbanglatigers.co.uk
PUBLIC_TINA_ADMIN_ORIGIN=

# Production site URL (Cloudflare Workers deploy). Astro uses this for sitemap/RSS/OG.
# Hard-coded in astro.config.mjs as fallback, but set here for builds that need deploy URL.
SITE_URL=https://ukbanglatigers.co.uk

# Astro preview background (required for Astro 7)
ASTRO_PREVIEW_BACKGROUND=false

# Reference directory for visual parity tests
UKBT_REFERENCE_DIR=
