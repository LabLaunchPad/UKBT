# Sentry (optional — only set in production environment)
SENTRY_DSN=

# TinaCMS Cloud (admin UI + schema indexing). Client ID is a public
# identifier; the token is SECRET — set it in the local .env (gitignored),
# GitHub Actions secrets (CI), and the Cloudflare Workers Builds environment.
# Never commit TINA_TOKEN or paste it into chat/docs/issues.
PUBLIC_TINA_CLIENT_ID=fe5da197-2c26-4071-9d72-e8216d5b53d6
TINA_TOKEN=
TINA_BRANCH=main

# Astro preview background (required for Astro 7)
ASTRO_PREVIEW_BACKGROUND=false

# Reference directory for visual parity tests
UKBT_REFERENCE_DIR=
