    "tokens:build": "style-dictionary build --config style-dictionary.config.json"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "style-dictionary": "^4.3.3"
  }
}
