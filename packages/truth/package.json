{
  "name": "@ukbt/truth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "UKBT content schemas + truth gate. Owns no framework/UI code. See contracts/TRUTH-CONTRACT.md, contracts/CONTENT-CONTRACT.md.",
  "exports": {
    ".": "./src/index.ts",
    "./gate": "./src/gate/index.ts",
    "./schema": "./src/schema/index.ts"
  },
