{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id","baseline_sha","commands","changed_files","acceptance","verdict"],
  "properties": {
    "task_id": {"type":"string"},
    "baseline_sha": {"type":"string","minLength":7},
    "commands": {"type":"array","items":{"type":"object","required":["command","exit_code"]}},
    "changed_files": {"type":"array","items":{"type":"string"}},
    "acceptance": {"type":"array","items":{"type":"object","required":["criterion","result"]}},
    "verdict": {"enum":["PASS","BLOCKED","FAIL"]}
  }
}
