node_modules/
dist/
.astro/
.wrangler/
.tina/
# TinaCMS v3 generated output (build intermediate). tina/tina-lock.json IS
# committed (TinaCloud requires it); everything else generated stays out.
tina/__generated__/
# Tina admin shell — generated by `tinacms build` into public/ (like
# tina/__generated__): build output, never source. Regenerated on every
# build; committing it would publish stale admin bundles.
apps/web/public/admin/
*.log
.env
.env.*
!.env.example

# Generated CSS/token output — never hand-edited, never source of truth.
# See contracts/CSS-CONTRACT.md and contracts/REPOSITORY-CONTRACT.md.
**/src/styles/generated/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Visual regression actual/diff output (references stay committed, see
# contracts/VISUAL-REGRESSION-CONTRACT.md — actual/diff artifacts are
# per-run, not the immutable reference itself)
**/tests/visual/**/*-actual.png
**/tests/visual/**/*-diff.png

# Local-only agent/session noise — untracked by design, never committed.
# (A parallel session's agent definitions + MCP logs; no secrets found
# 2026-09-26. If any of these become intentional repo content, that is a
# plan update + re-approval first.)
.opencode/Agentfile.json
.opencode/agents/design-*.md
.opencode/agents/engineering-*.md
.opencode/agents/marketing-*.md
.opencode/agents/testing-*.md
.opencode/agents/gis-*.md
.opencode/skills/.opencode/
.playwright-mcp/
