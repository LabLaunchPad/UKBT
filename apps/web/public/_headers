/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # No X-Frame-Options: it would override frame-ancestors below and block
  # the Tina admin's same-origin edit iframe (audit 2026-09-18). CSP
  # frame-ancestors is the governing control on every current browser.
  # script-src carries no 'unsafe-inline': __UKBT_CSP_SCRIPT_HASHES__ is
  # stamped at build time (scripts/stamp-csp.mjs) with the sha256 of every
  # inline executable script in dist; check-security.mjs recomputes and
  # enforces it. ld+json data blocks are non-executable and exempt.
  Content-Security-Policy: default-src 'self'; script-src 'self' __UKBT_CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://*.ingest.sentry.io https://app.tina.io https://*.tinajs.io https://s3.us-east-1.amazonaws.com https://us.i.posthog.com https://us-assets.i.posthog.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' https://app.tina.io https://*.tinajs.io; upgrade-insecure-requests

# Admin bundle (tinacms build output) inlines woff2/data fonts and a
# data: logo — browser-verified 2026-09-19: global font-src/img-src 'self'
# blocks them on /admin/. Scoped exception: data: added to font/img only
# here; script/style/connect/object/base-uri unchanged. ponytail: revisit
# if the admin bundle stops inlining assets.
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __UKBT_CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://app.tina.io https://*.tinajs.io https://s3.us-east-1.amazonaws.com https://us.i.posthog.com https://us-assets.i.posthog.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' https://app.tina.io https://*.tinajs.io; upgrade-insecure-requests

# PWA-lite cache matrix (2026-09-11): explicit Cache-Control per asset
# class. HTML intentionally has NO rule — Cloudflare serves it
# `public, max-age=0, must-revalidate` (observed), which is exactly the
# short/revalidation model HTML needs.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/social-card.jpg
  Cache-Control: public, max-age=2592000
/icon-32.png
  Cache-Control: public, max-age=2592000
/icon-180.png
  Cache-Control: public, max-age=2592000
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/sw.js
  Cache-Control: no-cache
/sw-register.js
  Cache-Control: public, max-age=86400
