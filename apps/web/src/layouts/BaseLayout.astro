---
// Foundation-stage layout. Per contracts/ROUTE-CONTRACT.md and
// contracts/SEO-CONTRACT.md, no metadata pipeline is wired yet — this is
// literal placeholder markup proving the build/CSS pipeline executes, not
// a real page. No UKBT organizational fact appears anywhere below.
//
// Generated by Style Dictionary from packages/truth/tokens/approved/ —
// gitignored, never hand-edited (contracts/CSS-CONTRACT.md,
// contracts/REPOSITORY-CONTRACT.md's generated-code policy). Produced by
// `pnpm build` (root script runs tokens:build before the Astro build).
import { ClientRouter } from 'astro:transitions';
import '../styles/generated/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import {
  DEFAULT_OG_IMAGE,
  LOCALE,
  SITE_NAME,
  canonicalFor,
  type OgImage,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** One or more JSON-LD graphs — only from `src/lib/seo.ts` emitters fed by gated content, never hand-built. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Keep the page out of search results. Required by
   * `contracts/ROUTE-CONTRACT.md` Amendment 01 condition 2 for the
   * commerce-shaped shells (`/services`, `/membership`, `/join`): their
   * structure is built, but UKBT has no evidence it offers those things,
   * and an indexed page is a public claim that it does.
   */
  noindex?: boolean;
  /** Suppress the canonical tag (error pages). Never use on indexable routes. */
  noCanonical?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: OgImage;
}
const {
  title,
  description,
  structuredData,
  noindex = false,
  noCanonical = false,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
} = Astro.props;

// Canonical is automatic: production origin + normalized route path.
// Emitted only for indexable routes — never pointing at a noindex URL.
const indexable = !noindex;
const canonical =
  indexable && !noCanonical ? canonicalFor(Astro.url.pathname) : null;
const graphs = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      First-visit logo intro state: synchronous pre-paint check (is:inline
      keeps it unbundled and render-blocking by intent — ~5 statements).
      Flag absent → arm the intro class and persist the flag immediately
      (a failed animation can never loop). Flag present, storage blocked,
      or no JS → no class → final logo state. ClientRouter navigations
      are handled by the lifecycle listeners below, never by this script.
    */}
    <script is:inline>
      try {
        if (!localStorage.getItem('ukbt-logo-intro-seen')) {
          document.documentElement.classList.add('ukbt-logo-intro');
          localStorage.setItem('ukbt-logo-intro-seen', '1');
        }
      } catch {
        /* Storage unavailable: fall through to the final logo state. */
      }
    </script>
    {/* Enhanced MPA navigation: cross-document View Transitions where
      supported, normal document navigation everywhere else (including
      no-JS). Never a functional dependency. */}
    <ClientRouter />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {indexable ? (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    ) : (
      <meta name="robots" content="noindex, follow" />
    )}
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/*
      No theme-color meta: manifest.webmanifest is the single source of
      truth for theme (#001E3A). A duplicate meta would cost ~50B of
      players/index.html weight, a page that lives 0.1KB under budget.
    */}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={LOCALE} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImage.alt} />
    <script src="/sw-register.js" defer></script>

    {
      graphs.map((g) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(g)} />
      ))
    }
  </head>
  <body>
    <slot />
    {/*
      Motion controller: one IntersectionObserver for every
      [data-motion] reveal site-wide — never per-element observers.
      Arms the page (html.ukbt-motion-js) so initial states apply only
      when observation is live; marks each element once and unobserves.
      No-JS, no-IO, or reduced-motion all resolve to static visible
      content. Re-executes on ClientRouter swaps for new content.
    */}
    <script>
      // First-visit logo-intro lifecycle: ClientRouter swaps the body
      // without a document load, so a surviving `ukbt-logo-intro` class
      // plus fresh header DOM would replay the intro. Removal happens
      // here — before the swap paints (before-swap) and asserted after
      // (after-swap) — never depending on head-script re-execution order.
      // `window` persists across swaps: the guard registers exactly once
      // per document lifetime no matter how many pages swap through it.
      const w = window as unknown as Record<string, boolean | undefined>;
      if (!w['__ukbtLogoIntroWired']) {
        w['__ukbtLogoIntroWired'] = true;
        document.addEventListener('astro:before-swap', () => {
          document.documentElement.classList.remove('ukbt-logo-intro');
        });
        document.addEventListener('astro:after-swap', () => {
          document.documentElement.classList.remove('ukbt-logo-intro');
        });
      }
      document.documentElement.classList.add('ukbt-motion-js');
      const revealEls = document.querySelectorAll('[data-motion="reveal"]');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (revealEls.length === 0 || reduceMotion || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const delay = el.dataset.motionDelay;
                if (delay) {
                  const capped = Math.min(Number(delay) || 0, 300);
                  el.style.transitionDelay = `${capped}ms`;
                }
                el.classList.add('is-visible');
                io.unobserve(el);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
