---
// CaptainSpotlight — editorial row: portrait beside the statement when a
// photo is provided, text-only composition otherwise. Used on the
// homepage and the players page for the Club Captain.
import Button from './Button.astro';

interface Props {
  name: string;
  role: string;
  /** Portrait src. When omitted, the text-only composition is rendered. */
  photo?: string;
  /** compact: teaser row. editorial: larger portrait + identity line
     (homepage narrative bridge). */
  density?: 'compact' | 'editorial';
  /** One concise identity line under the name (page-composed from gated
     values). Rendered only when provided. */
  identityLine?: string;
  /** CTA label. Defaults to the established 'Full profile'. */
  ctaLabel?: string;
}
const { name, role, photo, density = 'compact', identityLine, ctaLabel = 'Full profile' } = Astro.props;
---

<div class:list={['ukbt-captain', photo && 'ukbt-captain--with-photo', density === 'editorial' && 'ukbt-captain--editorial']}>
  {/*
    Shared-element portrait: the same captain photo renders here
    (home, players) and in ProfileHeader (club-captain) — same file,
    same 3:4 aspect — so this name genuinely pairs one semantic
    object across those pages. Exactly one instance per page.
  */}
  {
    photo && (
      <img
        src={photo}
        width="168"
        height="224"
        alt={`${name}, ${role}`}
        loading="lazy"
        class="ukbt-captain__photo"
        transition:name="ukbt-captain-portrait"
      />
    )
  }
  <div class="ukbt-captain__body">
    <span class="ukbt-captain__eyebrow ukbt-eyebrow">Club Captain</span>
    <h2 class="ukbt-captain__headline">Leading from the Front</h2>
    <div class="ukbt-captain__info">
      <span class="ukbt-captain__name">{name}</span>
      <span class="ukbt-captain__role">{role}</span>
      {identityLine && <span class="ukbt-captain__identity">{identityLine}</span>}
    </div>
    <div class="ukbt-captain__action">
      <Button label={ctaLabel} href="/club-captain" variant="primary" />
    </div>
  </div>
</div>

<style>
  .ukbt-captain {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    border-top: 3px solid var(--ukbt-color-brand-primary);
    padding-top: var(--ukbt-space-6);
  }
  /* Portrait row: fixed 3:4 frame, face kept via object-position top. */
  .ukbt-captain--with-photo {
    flex-direction: row;
    align-items: center;
    gap: var(--ukbt-space-8);
  }
  .ukbt-captain__photo {
    width: 10.5rem;
    /* height:auto so aspect-ratio (not the height="" attribute) governs
       the frame at every width — same defect class as the roster cards. */
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: var(--ukbt-radius-ref-card);
    flex: none;
  }
  .ukbt-captain__body {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    min-width: 0;
  }
  /* Eyebrow uses the shared .ukbt-eyebrow grammar (base.css); the local
     class remains as the component hook. */
  .ukbt-captain__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-captain__info {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
  }
  .ukbt-captain__name {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-2);
    font-weight: 600;
  }
  .ukbt-captain__role {
    font-size: var(--ukbt-font-size-1);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-captain__identity {
    font-size: var(--ukbt-font-size-1);
    color: var(--ukbt-color-neutral-700);
    max-width: 36rem;
  }
  /* Editorial density: larger portrait + headline for the homepage
     narrative bridge. Photo stays well under the 640px source width. */
  .ukbt-captain--editorial .ukbt-captain__photo {
    width: 14rem;
  }
  .ukbt-captain--editorial .ukbt-captain__headline {
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3rem);
  }
  .ukbt-captain__action {
    margin-top: var(--ukbt-space-2);
    align-self: flex-start;
  }

  @media screen and (max-width: 767px) {
    .ukbt-captain--with-photo {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--ukbt-space-6);
    }
    .ukbt-captain__photo {
      width: 100%;
      max-width: 20rem;
      height: 24rem;
    }
  }
</style>
