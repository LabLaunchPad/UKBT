---
// SquadCard — editorial roster card shared by the /players Squad and
// the Uppsala Tigers squad (both render it through SquadGrid; the old
// RosterGrid.astro was retired when Uppsala migrated to this system).
// Carries its own ukbt-squad-* hooks, asserted by pages.spec.ts.
//
// Truth posture: every rendered line maps to a verified player field.
// Badges may ONLY be Wicket-keeper / U-19 / All-Rounder (the only
// verified position-ish tags — All-Rounder solely for the two
// EV-20260911-002 players) — no Batter/Bowler taxonomy may be added
// unless the data model proves it. The Uppsala affiliation renders as
// a demoted meta line, never the primary identity. Cards are never
// links: full profiles beyond the Club Captain are UNKNOWN, so no
// arrow/profile affordance is rendered.
//
// Photo-less players get a deliberate monogram variant (initials are a
// transform of the verified name, not invented content) — same card
// width and family, never a placeholder silhouette.
//
// Eager images, fixed dimensions, top-centre crop: chosen for
// deterministic full-page screenshot capture — do not reintroduce
// lazy loading here.
import type { RosterPlayer } from '../content/players-data';

interface Props {
  player: RosterPlayer;
  /** 'official' promotes the staff role to primary metadata and omits
      the country line — staff have no playing country. */
  variant?: 'player' | 'official';
  /** Organisation named in the alt fallback when a record carries no
      explicit photoAlt. Players page: UK Bangla Tigers; Uppsala Tigers
      detail page: Uppsala Tigers (their records have no photoAlt, and
      the UKBT fallback would mislabel them). */
  org?: string;
}

const { player: p, variant = 'player', org = 'UK Bangla Tigers' } = Astro.props;
const isOfficial = variant === 'official';

// Badge-worthy tags: verified playing tags only (Wicket-keeper, U-19,
// and All-Rounder for the two EV-20260911-002 players). The Uppsala
// squad spells it 'Wicketkeeper' — same verified role, normalised to
// the hyphenated display form so both squads read identically. The
// Uppsala affiliation is rendered separately as demoted metadata,
// never badged.
const BADGE_LABELS: Record<string, string> = {
  'Wicket-keeper': 'Wicket-keeper',
  Wicketkeeper: 'Wicket-keeper',
  'U-19': 'U-19',
  'All-Rounder': 'All-Rounder',
};
const badges = [
  ...new Set(
    (p.tags ?? [])
      .filter((t) => t in BADGE_LABELS)
      .map((t) => BADGE_LABELS[t]),
  ),
];
// Any other verified tag (e.g. 'Captain', 'Overseas Signing') renders
// as a demoted meta line — never dropped silently, never promoted to
// a badge that could imply an unproven hierarchy.
const meta = (p.tags ?? []).filter(
  (t) => !(t in BADGE_LABELS) && t !== 'Also plays for Uppsala Tigers',
);
const uppsala = (p.tags ?? []).includes('Also plays for Uppsala Tigers');

// Monogram for the text-only variant: initials of the verified name.
const initials = p.name
  .split(/\s+/)
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<article class="ukbt-squad-card">
  {
    p.photo ? (
      <div class="ukbt-squad-card__media">
        <img
          src={p.photo}
          alt={p.photoAlt ?? `${p.name} — ${org}`}
          width="320"
          height="320"
        />
        {badges.length > 0 && (
          <p class="ukbt-squad-card__badge">{badges.join(' · ')}</p>
        )}
      </div>
    ) : (
      <div class="ukbt-squad-card__text" aria-hidden="true">
        <span>{initials}</span>
        {badges.length > 0 && (
          <p class="ukbt-squad-card__badge">{badges.join(' · ')}</p>
        )}
      </div>
    )
  }
  <div class="ukbt-squad-card__body">
    <h3 class="ukbt-squad-card__name">{p.name}</h3>
    {
      isOfficial ? (
        <p class="ukbt-squad-card__role">{p.role}</p>
      ) : p.country ? (
        <p class="ukbt-squad-card__country">{p.country}</p>
      ) : (
        <p class="ukbt-squad-card__country">Country unconfirmed</p>
      )
    }
    {
      !isOfficial && uppsala && (
        <p class="ukbt-squad-card__affil">Also plays for Uppsala Tigers</p>
      )
    }
    {
      meta.length > 0 &&
        meta.map((t) => <p class="ukbt-squad-card__meta">{t}</p>)
    }
    {
      p.note && (
        <details class="ukbt-squad-card__evidence">
          <summary>Verified note</summary>
          <p>{p.note}</p>
        </details>
      )
    }
  </div>
</article>

<style>
  .ukbt-squad-card {
    background: var(--ukbt-color-neutral-0);
    border: 1px solid var(--ukbt-color-neutral-100);
    border-radius: var(--ukbt-radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
    /* Anchor for the photo-overlap badge (its media wrapper is the
       nearer anchor when present; text-only cards anchor here). */
    position: relative;
  }
  .ukbt-squad-card__media {
    position: relative;
  }
  /* Photo / monogram fill the media box; the selectors stay
     element-based so no per-card class bytes ship. */
  .ukbt-squad-card__media > img {
    display: block;
    width: 100%;
    /* height:auto is load-bearing: without it the height="" attribute
       (a presentational hint) beats aspect-ratio and every portrait
       renders tall instead of square — measured 175x320 at 1440px. */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* Top-anchored: faces sit high in the supplied portraits. */
    object-position: top center;
    background: var(--ukbt-color-surface-alt);
  }
  /* Text-only variant: same square geometry as a photo, monogram on
     navy — intentional, not a broken image. */
  .ukbt-squad-card__text {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ukbt-color-brand-primary);
  }
  .ukbt-squad-card__text > span {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-5);
    font-weight: var(--ukbt-font-weight-bold);
    color: var(--ukbt-color-brand-accent);
    letter-spacing: 0.04em;
  }
  /* Verified-tag badge overlapping the media bottom-left. */
  .ukbt-squad-card__badge {
    position: absolute;
    left: var(--ukbt-space-2);
    bottom: var(--ukbt-space-2);
    margin: 0;
    max-width: calc(100% - var(--ukbt-space-4));
    background: var(--ukbt-color-brand-primary);
    color: var(--ukbt-color-neutral-0);
    border-radius: var(--ukbt-radius-sm, 4px);
    padding: 2px var(--ukbt-space-2);
    font-size: var(--ukbt-font-size-0);
    font-weight: var(--ukbt-font-weight-bold);
    line-height: 1.4;
  }
  .ukbt-squad-card__body {
    padding: var(--ukbt-space-3) var(--ukbt-space-3) var(--ukbt-space-4)
      var(--ukbt-space-3);
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  .ukbt-squad-card__name {
    margin: 0;
    font-size: var(--ukbt-font-size-1);
    line-height: 1.3;
  }
  /* 320px two-up cards are ~120px wide: step the name down one type
     level so multi-word names wrap in 2–3 lines, not 4–5. */
  @media screen and (max-width: 380px) {
    .ukbt-squad-card__name {
      font-size: var(--ukbt-font-size-0);
    }
    .ukbt-squad-card__body {
      padding: var(--ukbt-space-2) var(--ukbt-space-2) var(--ukbt-space-3)
        var(--ukbt-space-2);
    }
  }
  .ukbt-squad-card__country {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
  .ukbt-squad-card__role {
    margin: 0;
    color: var(--ukbt-color-brand-primary);
    font-size: var(--ukbt-font-size-0);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-squad-card__affil,
  .ukbt-squad-card__meta {
    margin: var(--ukbt-space-1) 0 0 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
    line-height: 1.4;
  }
  /* Native <details> keeps the full note one tap away. */
  .ukbt-squad-card__evidence {
    margin: var(--ukbt-space-2) 0 0 0;
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-squad-card__evidence summary {
    cursor: pointer;
    color: var(--ukbt-color-brand-primary);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-squad-card__evidence p {
    margin: var(--ukbt-space-1) 0 0 0;
    font-style: italic;
    line-height: 1.5;
  }
</style>
