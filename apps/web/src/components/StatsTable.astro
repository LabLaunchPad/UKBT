---
// UKBT-original — no Adelux equivalent exists. Real semantic <table>
// (not a div-grid) so screen readers get correct row/column association;
// styled with the existing design-system tokens, not the source PDF's
// own screenshot styling (client instruction, C-005/C-006: "use your own
// style table and format").
interface Props {
  caption: string;
  headers: string[];
  rows: (string | number)[][];
}
const { caption, headers, rows } = Astro.props;
---

{/*
  The wrapper scrolls horizontally: measured at 320-430px the table is a
  fixed 491px (cells are `white-space: nowrap`, correctly — wrapped score
  columns are harder to read), so 61-171px of it sits off-screen on a
  phone. A scroll container reachable only by dragging is a WCAG 2.1.1
  (Keyboard) failure, so it is exposed as a focusable, named region:
  `tabindex="0"` lets a keyboard user scroll it with the arrow keys, and
  role+aria-label mean a screen reader announces what the region is
  rather than an unlabelled scrollable box.
*/}
<div class="ukbt-stats-card">
  <div class="ukbt-stats-card__head" aria-hidden="true">
    <span class="ukbt-stats-card__icon">
      {
        caption === 'Bowling' ? (
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="8.5" fill="var(--ukbt-color-brand-accent)" />
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="var(--ukbt-color-brand-accent-active)" stroke-opacity="0.35" />
            <path
              d="M8 8.5 Q12 12 16 15.5"
              fill="none"
              stroke="var(--ukbt-color-neutral-0)"
              stroke-width="1.2"
              stroke-linecap="round"
              opacity="0.95"
            />
            <path
              d="M9.5 10 Q12.2 12.2 14.5 14"
              fill="none"
              stroke="var(--ukbt-color-neutral-0)"
              stroke-width="0.7"
              stroke-linecap="round"
              opacity="0.55"
            />
          </svg>
        ) : (
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            aria-hidden="true"
          >
            <g transform="rotate(-30 12 12)">
              <rect x="10.6" y="2" width="2.8" height="7.5" rx="1.1" fill="var(--ukbt-color-brand-accent)" stroke="var(--ukbt-color-brand-accent-active)" stroke-width="0.6" />
              <rect x="9.2" y="9" width="5.6" height="13" rx="1.6" fill="var(--ukbt-color-brand-accent)" stroke="var(--ukbt-color-brand-accent-active)" stroke-width="0.6" />
              <line x1="9.2" y1="12.2" x2="14.8" y2="12.2" stroke="var(--ukbt-color-brand-accent-active)" stroke-width="0.4" opacity="0.5" />
              <line x1="9.2" y1="15" x2="14.8" y2="15" stroke="var(--ukbt-color-brand-accent-active)" stroke-width="0.4" opacity="0.5" />
            </g>
          </svg>
        )
      }
    </span>
    <span class="ukbt-stats-card__title">{caption}</span>
    <span class="ukbt-stats-card__rule"></span>
    <span class="ukbt-stats-card__all">ALL FORMATS</span>
  </div>
  <div
    class="ukbt-stats-table-wrap"
    tabindex="0"
    role="region"
    aria-label={caption}
  >
    <table class="ukbt-stats-table">
      <caption class="ukbt-sr-only">{caption} — all formats</caption>
    <thead>
      <tr>
        {headers.map((h) => <th scope="col">{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell, i) =>
              i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
            )}
          </tr>
        ))
      }
      </tbody>
    </table>
  </div>
</div>

<style>
  .ukbt-stats-card {
    background: var(--ukbt-color-neutral-0);
    border: 1px solid var(--ukbt-color-neutral-100);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1px 0 rgba(var(--ukbt-color-brand-primary-rgb, 0, 30, 58), 0.04);
  }
  .ukbt-stats-card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px 10px;
  }
  .ukbt-stats-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .ukbt-stats-card__title {
    font-family: var(--ukbt-font-family-heading);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--ukbt-color-brand-primary);
    letter-spacing: -0.01em;
    flex: none;
  }
  .ukbt-stats-card__rule {
    flex: 1;
    height: 1px;
    background: var(--ukbt-color-brand-accent);
    margin-inline: 6px 8px;
    align-self: center;
  }
  .ukbt-stats-card__all {
    flex: none;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    /* #7A5600 on white = 7.1:1, passes 4.5:1 where #c9a04a (2.43:1) failed */
    color: var(--ukbt-color-feedback-warning);
    white-space: nowrap;
  }
  .ukbt-stats-table-wrap {
    overflow-x: auto;
    padding: 0 10px 6px;
  }
  .ukbt-stats-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--ukbt-font-size-0);
  }
  .ukbt-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .ukbt-stats-table th,
  .ukbt-stats-table td {
    padding: 11px var(--ukbt-space-3);
    text-align: right;
    border-bottom: 1px solid var(--ukbt-color-neutral-100);
    white-space: nowrap;
  }
  /* Header bar — navy pill */
  .ukbt-stats-table thead tr {
    background: var(--ukbt-color-brand-primary);
  }
  .ukbt-stats-table thead th {
    color: var(--ukbt-color-neutral-0);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    border-bottom: none;
    padding-block: 11px;
  }
  .ukbt-stats-table thead th:first-child {
    color: var(--ukbt-color-brand-accent);
    text-align: left;
    font-weight: 700;
    border-radius: 0;
  }
  .ukbt-stats-table thead tr th:first-child {
    border-radius: 8px 0 0 8px;
  }
  .ukbt-stats-table thead tr th:last-child {
    border-radius: 0 8px 8px 0;
  }
  /* Body rows */
  .ukbt-stats-table tbody tr:last-child td,
  .ukbt-stats-table tbody tr:last-child th {
    border-bottom: none;
  }
  .ukbt-stats-table th[scope='row'] {
    text-align: left;
    font-weight: 700;
    color: var(--ukbt-color-brand-primary);
  }
  .ukbt-stats-table td {
    color: var(--ukbt-color-neutral-700);
    font-variant-numeric: tabular-nums;
  }
  /* Keep gold rule aligned with header bar */
  @media screen and (max-width: 767px) {
    .ukbt-stats-card__head {
      padding-inline: 12px;
    }
    .ukbt-stats-card__title {
      font-size: 1.15rem;
    }
    .ukbt-stats-table th,
    .ukbt-stats-table td {
      padding-inline: var(--ukbt-space-2);
    }
  }
</style>
