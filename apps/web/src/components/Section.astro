---
// Page-rhythm primitive, carrying the reference's measured section
// geometry (CLIENT_REQ_012 / EV-20260826-032): 120px block padding, 20px
// inline, inside a 1340px container.
//
// `wrapper` mirrors the reference's `.section-wrapper` — a 30px inset
// (20px <=1025px, 10px <=767px) used when a section needs to sit as a
// rounded, tinted panel floating within the page rather than running
// full-bleed. That inset is what produces the template's characteristic
// rounded section blocks.
interface Props {
  paddingTop?: 'none' | 'normal';
  paddingBottom?: 'none' | 'normal';
  surface?: 'default' | 'alt' | 'inverse';
  /** Inset the section as a rounded panel (reference `.section-wrapper`). */
  wrapper?: boolean;
  /** Compact density for long editorial pages (measured 160/240px voids). */
  density?: 'normal' | 'compact';
  as?: 'section' | 'div';
}
const {
  paddingTop = 'normal',
  paddingBottom = 'normal',
  surface = 'default',
  wrapper = false,
  density = 'normal',
  as: Tag = 'section',
} = Astro.props;

const cls = [
  'ukbt-section',
  `ukbt-section--pt-${paddingTop}`,
  `ukbt-section--pb-${paddingBottom}`,
  `ukbt-section--surface-${surface}`,
  wrapper ? 'ukbt-section--wrapper' : '',
  density === 'compact' ? 'ukbt-section--density-compact' : '',
]
  .filter(Boolean)
  .join(' ');
---

<Tag class={cls}>
  <div class="ukbt-container">
    <slot />
  </div>
</Tag>

<style>
  /* Reference `.section`: padding 120px 20px */
  .ukbt-section {
    padding-block: var(--ukbt-space-section-padding);
  }
  /* Compact density (D1 audit): long editorial pages stack many
     120px-padded sections into 240px voids. Halved via the space
     scale — opt-in per section, global rhythm untouched. */
  .ukbt-section--density-compact {
    padding-block: calc(var(--ukbt-space-8) * 2);
  }
  .ukbt-section--pt-none {
    padding-top: 0;
  }
  .ukbt-section--pb-none {
    padding-bottom: 0;
  }
  /* No surface-default rule: it would restate the body
     background/foreground verbatim (sections always render at page top
     level, never inside a tinted ancestor), so the default inherits. */
  .ukbt-section--surface-alt {
    background: var(--ukbt-color-surface-alt);
    color: var(--ukbt-color-surface-foreground);
  }
  .ukbt-section--surface-inverse {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    /* Descendants (buttons, links, scroll regions) inherit the global
       CanvasText focus ring — invisible on navy (~1.25:1). Repaint it
       gold for the whole subtree, same mechanism as Hero/PageBanner. */
    --ukbt-color-focus-ring: var(--ukbt-color-brand-accent);
  }

  /* Reference `.section-wrapper`: inset the panel and round its corners. */
  .ukbt-section--wrapper {
    margin-inline: var(--ukbt-space-section-wrapper);
    border-radius: var(--ukbt-radius-ref-card);
    overflow: hidden;
  }

  @media screen and (max-width: 1025px) {
    .ukbt-section--wrapper {
      margin-inline: var(--ukbt-space-section-wrapper-md);
    }
  }
  /* NOTE: section block padding steps down on mobile for proportion.
     The reference holds 120px at all viewports, but UKBT's longer copy
     means the vertical space consumed by padding on small screens
     outweighs the proportion benefit. 80px preserves breathing room
     while recovering usable content space. Single <=767px block. */
  @media screen and (max-width: 767px) {
    .ukbt-section--wrapper {
      margin-inline: var(--ukbt-space-section-wrapper-sm);
    }
    .ukbt-section {
      padding-block: 80px;
    }
    .ukbt-section--density-compact {
      padding-block: calc(var(--ukbt-space-8) * 1.5);
    }
  }
</style>
