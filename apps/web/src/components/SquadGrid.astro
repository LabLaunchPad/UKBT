---
// SquadGrid — filterable editorial roster grid for /players.
//
// Filter dimensions derive ONLY from verified RosterPlayer fields:
// photo presence, Wicket-keeper tag, U-19 tag, Uppsala affiliation,
// plus the All-Rounders role (owner-verbatim role, EV-20260923-002 —
// the same source matches('r') reads as badge text).
// A filter renders only when at least one record matches it — no empty
// categories, no invented counts. Other role filters (Batsmen/Bowlers)
// are deliberately not offered by design, not because no taxonomy exists.
//
// Progressive enhancement: the filter bar is hidden until the
// component script runs (data-squad-ready), so no-JS renders the full
// roster with no dead controls. Filtering is vanilla DOM toggling —
// no framework, no hydration cost.
import type { RosterPlayer } from '../content/players-data';
import SquadCard from './SquadCard.astro';

interface Props {
  players: RosterPlayer[];
  /** 'player' | 'official' — forwarded to every SquadCard. */
  variant?: 'player' | 'official';
  /** Render the data-derived filter bar. Officials (4 records, role-led)
      omit it. */
  filters?: boolean;
  /** aria-label for the filter group. */
  filterLabel?: string;
  /** Unit noun for the live count line ('Players' / 'Officials'). */
  unit?: string;
  /** Organisation for card alt fallbacks (see SquadCard). */
  org?: string;
  /** Root id for aria association. */
  id?: string;
}

const {
  players,
  variant = 'player',
  filters = true,
  filterLabel = 'Filter squad',
  unit = 'Players',
  org = 'UK Bangla Tigers',
  id = 'squad',
} = Astro.props;

interface Filter {
  key: string;
  label: string;
  count: number;
}

const UPC_TAG = 'Also plays for Uppsala Tigers';
// Single-letter filter keys keep the shipped HTML small; the script
// below maps them back to DOM-derived card membership (photo presence,
// badge text, the data-uppsala attribute) so only one per-card data
// attribute ships.
const allFilters: Filter[] = [
  { key: 'a', label: 'All', count: players.length },
  {
    key: 'p',
    label: 'With Photos',
    count: players.filter((p) => p.photo).length,
  },
  {
    key: 'n',
    label: 'No Photos',
    count: players.filter((p) => !p.photo).length,
  },
  {
    key: 'k',
    label: 'Wicket-keepers',
    // The Uppsala squad spells the verified tag 'Wicketkeeper' —
    // counted together, badged identically (see SquadCard).
    count: players.filter((p) =>
      (p.tags ?? []).some(
        (t) => t === 'Wicket-keeper' || t === 'Wicketkeeper',
      ),
    ).length,
  },
  {
    key: 'r',
    label: 'All-Rounders',
    // Render count mirrors matches('r') badge logic (role-derived badge +
    // legacy All-Rounder tag): role is the grouping truth (EV-20260923-002).
    count: players.filter(
      (p) =>
        (p.role === 'All-rounder' ? 'All-Rounder' : (p.role ?? '')).includes(
          'All-Rounder',
        ) || (p.tags ?? []).includes('All-Rounder'),
    ).length,
  },
  {
    key: 'j',
    label: 'U-19',
    count: players.filter((p) => (p.tags ?? []).includes('U-19')).length,
  },
  {
    key: 't',
    label: 'Uppsala Tigers',
    count: players.filter((p) => (p.tags ?? []).includes(UPC_TAG)).length,
  },
];
// 'All' always renders; every other filter needs ≥1 real record.
const visibleFilters = allFilters.filter((f) => f.key === 'a' || f.count > 0);
---

<div class="ukbt-squad" id={id} data-squad-grid>
  {
    filters && (
      <div class="ukbt-squad__bar">
        <div class="ukbt-squad__filters" role="group" aria-label={filterLabel}>
          {visibleFilters.map((f, i) => (
            <button
              class="ukbt-squad__filter"
              data-filter={f.key}
              aria-pressed={i === 0 ? 'true' : undefined}
            >
              {f.label}
            </button>
          ))}
        </div>
        <p class="ukbt-squad__count" data-squad-count aria-live="polite">
          {players.length} {unit}
        </p>
      </div>
    )
  }
  <div class="ukbt-squad__grid">
    {players.map((p) => (
      <SquadCard player={p} variant={variant} org={org} />
    ))}
  </div>
</div>

<script>
  // Scoped per grid instance. Membership is read from the rendered card
  // (photo presence, badge text, the data-uppsala attribute) — the only
  // verified sources.
  // ClientRouter-proofed (AL-042): Astro runs this script once per
  // document, but swaps the grid DOM on every navigation. init() wires
  // the CURRENT roots and runs on astro:page-load.
  function init() {
  for (const root of document.querySelectorAll('[data-squad-grid]')) {
    if (root.hasAttribute('data-squad-wired')) continue;
    const buttons = [...root.querySelectorAll('[data-filter]')];
    if (buttons.length === 0) continue;
    root.setAttribute('data-squad-wired', 'true');
    const cards = [...root.querySelectorAll('.ukbt-squad-card')];
    const badge = (c: Element) =>
      c.querySelector('.ukbt-squad-card__badge')?.textContent ?? '';
    const matches = (c: Element, key: string): boolean => {
      if (key === 'a') return true;
      if (key === 'p') return c.querySelector('img') !== null;
      if (key === 'n') return c.querySelector('img') === null;
      if (key === 'k') return badge(c).includes('Wicket-keeper');
      if (key === 'r') return badge(c).includes('All-Rounder');
      if (key === 'j') return badge(c).includes('U-19');
      if (key === 't') return (c as HTMLElement).dataset.uppsala === 'true';
      return true;
    };
    const count = root.querySelector('[data-squad-count]');
    const total = cards.length;
    const unit =
      (count?.textContent ?? '').replace(/^\d+\s*/, '') || 'Players';
    const apply = (key: string) => {
      let shown = 0;
      for (const card of cards) {
        const show = matches(card, key);
        card.toggleAttribute('hidden', !show);
        if (show) shown += 1;
      }
      for (const b of buttons) {
        b.setAttribute(
          'aria-pressed',
          b.getAttribute('data-filter') === key ? 'true' : 'false',
        );
      }
      if (count) count.textContent = `${shown} of ${total} ${unit}`;
    };
    for (const b of buttons) {
      b.addEventListener('click', () =>
        apply(b.getAttribute('data-filter') ?? 'a'),
      );
    }
    // Expose every toggle's state (and the total count) as soon as the
    // script runs — initial HTML carries pressed only on 'All'.
    apply('a');
    root.setAttribute('data-squad-ready', 'true');
  }
  }
  const w = window as unknown as Record<string, boolean | undefined>;
  if (!w['__ukbtSquadWired']) {
    w['__ukbtSquadWired'] = true;
    document.addEventListener('astro:page-load', init);
  }
  init();
</script>

<style>
  .ukbt-squad__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--ukbt-space-3);
    margin-bottom: var(--ukbt-space-6);
  }
  /* Hidden until the filter script runs — no-JS shows the full roster
     with no dead controls. */
  .ukbt-squad__filters {
    display: none;
    flex-wrap: wrap;
    gap: var(--ukbt-space-2);
  }
  [data-squad-ready] .ukbt-squad__filters {
    display: flex;
  }
  .ukbt-squad__filter {
    appearance: none;
    border: 1px solid var(--ukbt-color-neutral-100);
    background: var(--ukbt-color-neutral-0);
    color: var(--ukbt-color-brand-primary);
    border-radius: 999px;
    /* ~39px tall: comfortably above the 24px minimum target with room
       for touch use, while staying a compact control strip. */
    padding: var(--ukbt-space-2) var(--ukbt-space-3);
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-0);
    font-weight: 600;
    line-height: 1.5;
    cursor: pointer;
  }
  .ukbt-squad__filter:hover {
    border-color: var(--ukbt-color-brand-primary);
  }
  .ukbt-squad__filter:active {
    background: var(--ukbt-color-neutral-50);
    border-color: var(--ukbt-color-brand-primary);
  }
  .ukbt-squad__filter[aria-pressed='true'] {
    background: var(--ukbt-color-brand-primary);
    border-color: var(--ukbt-color-brand-primary);
    color: var(--ukbt-color-neutral-0);
    /* Non-color selected signal alongside aria-pressed: underline
       persists where color alone does not. Selected stays last so
       it wins over hover/active. */
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ukbt-squad__count {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
    white-space: nowrap;
  }
  .ukbt-squad__grid {
    display: grid;
    /* Mobile-first: exactly 2-up on all phones (320→120px cards,
       430→~165px) — auto-fill alone can't cap the column count and
       drifts to 3-up on large phones. Square media + stretched rows
       keep every card's geometry systematic at any width. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Fluid gutter: space-3 on phones → space-4 from ~800px.
       Endpoints are existing scale steps; desktop gap stays 1rem
       so the 5-column ≥1100px geometry is unchanged. */
    gap: clamp(
      var(--ukbt-space-3),
      calc(var(--ukbt-space-2) + 1vw),
      var(--ukbt-space-4)
    );
  }
  /* ≥700px: fluid columns resume — 4 at 768, 5 at 1024. */
  @media screen and (min-width: 700px) {
    .ukbt-squad__grid {
      grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    }
  }
  /* Desktop comfort: the base floor reads narrow with long card
     bodies on wide screens, so ≥1100px steps up to five wider
     (~240px) columns. Small screens keep the base floor. */
  @media screen and (min-width: 1100px) {
    .ukbt-squad__grid {
      grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    }
  }
  /* Grid items are the SquadCard articles directly (no wrapper divs —
     keeps players/index.html under the html-weight budget). The cards
     carry SquadCard's scope id, not this component's, so the article
     selectors are global to match across the component boundary. */
  .ukbt-squad__grid > :global(article) {
    min-width: 0;
  }
  .ukbt-squad__grid > :global(article[hidden]) {
    display: none;
  }
</style>
