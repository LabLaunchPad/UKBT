---
// FounderSpotlight — About Phase 1 (legacy S2 port). Mirrors AboutStory's
// visual grammar (flex row, gap-100, align-items center; image side +
// content side with narrative + accent-ruled stat row; column-reverse at
// <=1025px) for a named-person spotlight with a stat pair. Separate
// component because AboutStory is the club story and LeadershipGrid is
// name+role cards — neither fits. Copy + stats are gated facts from
// about-data.ts (org.founder_story, org.stat_career_matches,
// org.stat_active_players); image is the owner-authorised trophy photo
// (MANIFEST "Leadership photography").
interface Stat {
  value: string;
  label: string;
  /** R-A visual anchor only (presentation mapping in about.astro, not
     gated data): trophy = career aggregate, people = active subset. */
  icon?: 'trophy' | 'people';
}
interface Props {
  image: { src: string; alt: string; width: number; height: number };
  cardTitle: string;
  eyebrow: string;
  heading: string;
  paragraphs: string[];
  stats: Stat[];
  /** A1: 'mirror' puts image right / content left on desktop so the
     back-to-back story sections stop reading as twins. Default
     preserves behavior; stacking unchanged (DOM order untouched). */
  composition?: 'default' | 'mirror';
}
// NOTE: `Astro.props` inference does not pick up `Props` in this file
// (verified: identical frontmatter shape works in AboutStory and
// LeadershipGrid), so the association is stated explicitly. Runtime
// shape is covered by the About page render + e2e.
const props = Astro.props as Props;
const { image, cardTitle, eyebrow, heading, paragraphs, stats, composition = 'default' } = props;
import SubHeading from './SubHeading.astro';
---

<div class:list={['ukbt-founder', composition === 'mirror' && 'ukbt-founder--mirror']}>
  <div class="ukbt-founder__image-side">
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={image.alt}
      loading="lazy"
    />
    <div class="ukbt-founder__detail-card">
      <p>{cardTitle}</p>
    </div>
  </div>
  <div class="ukbt-founder__content-side">
    <SubHeading label={eyebrow} />
    <h2>{heading}</h2>
    <div class="ukbt-founder__paragraphs">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="ukbt-founder__stats">
      {
        stats.map((s) => (
          <div class="ukbt-founder__stat">
            {s.icon === 'trophy' && (
              <svg class="ukbt-founder__stat-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 4h10v5a5 5 0 0 1-10 0V4z" />
                <path d="M7 5H4.5A1.5 1.5 0 0 0 3 6.5C3 8.5 4.5 10 6.6 10" />
                <path d="M17 5h2.5A1.5 1.5 0 0 1 21 6.5C21 8.5 19.5 10 17.4 10" />
                <path d="M12 14v4" />
                <path d="M8.5 20h7" />
                <path d="M10 18h4" />
              </svg>
            )}
            {s.icon === 'people' && (
              <svg class="ukbt-founder__stat-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="8" r="3.2" />
                <path d="M3.5 19c.8-3 2.9-4.6 5.5-4.6s4.7 1.6 5.5 4.6" />
                <circle cx="16.8" cy="9" r="2.5" />
                <path d="M16.2 14.6c2.4.4 4.1 2 4.6 4.4" />
              </svg>
            )}
            <span class="ukbt-founder__stat-value">{s.value}</span>
            <span class="ukbt-founder__stat-label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .ukbt-founder {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--ukbt-space-gap-100);
  }
  /* A1: mirrored desktop composition only — <=1025px stacking stays
     byte-identical. */
  @media screen and (min-width: 1026px) {
    .ukbt-founder--mirror {
      flex-direction: row-reverse;
    }
  }
  .ukbt-founder__image-side {
    position: relative;
    flex: 0 0 40%;
    max-width: 40%;
  }
  .ukbt-founder__image-side img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 30rem;
    object-fit: cover;
    border-radius: var(--ukbt-radius-ref-card);
  }
  .ukbt-founder__detail-card {
    position: absolute;
    left: var(--ukbt-space-gap-2);
    right: var(--ukbt-space-gap-2);
    bottom: var(--ukbt-space-gap-2);
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    border-radius: var(--ukbt-radius-ref-card-asymmetric);
    padding: var(--ukbt-space-gap-2);
    box-shadow: var(--ukbt-shadow-md);
  }
  .ukbt-founder__detail-card p {
    margin: 0;
    font-size: var(--ukbt-font-size-0);
    text-align: center;
  }
  .ukbt-founder__content-side {
    flex: 1 1 auto;
  }
  .ukbt-founder__content-side h2 {
    margin: var(--ukbt-space-2) 0 var(--ukbt-space-4) 0;
  }
  .ukbt-founder__paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    max-width: 42rem;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-body-paragraph-size);
    line-height: var(--ukbt-font-line-height-body);
  }
  .ukbt-founder__paragraphs p {
    margin: 0;
  }
  .ukbt-founder__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--ukbt-space-4);
    margin-top: var(--ukbt-space-6);
    max-width: 32rem;
  }
  .ukbt-founder__stat {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
    /* Owner direction 2026-09-11 (dual-40+ restyle): personal-scope
       stats use a navy rule, club-scope stats in AboutStory keep the
       gold rule — identical numerals stay distinguishable by treatment.
       Gated values untouched. */
    border-top: 2px solid var(--ukbt-color-brand-primary);
    padding-top: var(--ukbt-space-2);
  }
  /* R-A visual anchors: small quiet gold outline icons in the Button
     stroke language (1.8, round caps). Decorative — aria-hidden in
     markup — aligned to the value, never competing with it. */
  .ukbt-founder__stat-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-founder__stat-value {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-4);
    font-weight: var(--ukbt-font-weight-bold);
    color: var(--ukbt-color-brand-primary);
  }
  .ukbt-founder__stat-label {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }

  /* D3/N3 audit: the portrait source (1000x1252) under cover + the
     30rem cap becomes a band at tablet widths — face and trophy cut.
     Constrain the slot so the frame stays near the natural aspect.
     No lower bound: below ~448px widths the cap is a no-op, which also
     removes the 766/768 breakpoint-edge discontinuity. Merged into the
     single <=1025px block above to avoid a duplicate media query. */
  @media screen and (max-width: 1025px) {
    .ukbt-founder {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: var(--ukbt-space-gap-5);
    }
    .ukbt-founder__image-side {
      flex: 1 1 auto;
      width: 100%;
      max-width: 28rem;
      margin-inline: auto;
    }
  }
  @media screen and (max-width: 767px) {
    .ukbt-founder__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
