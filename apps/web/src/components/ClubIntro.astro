---
// ClubIntro — re-artirected. Editorial composition:
// large TEAM slideshow, large statement, supporting copy, typographic statistics.
// No cards, no overlay, no boxes around numbers.
//
// TEAM-ONLY enforcement: this section must show ONLY multi-player team
// pictures (≥2 players in frame) with no trophy/award as the subject.
// Single-player portraits (club-feature.webp / gallery-07, gallery-01,
// gallery-03, gallery-12-17, etc.) and trophy-centric frames
// (gallery-06, -10, -11, gallery-05 plaque, founder-trophy) are explicitly
// forbidden here — see artifacts/brand/raw/images/gallery review and
// MANIFEST.md Client-authorised photography notes. The array below is the
// single source of truth; adding an individual or trophy image is a defect.
import { tinaField } from '@tinacms/astro';

interface Stat {
  value: string;
  label: string;
}
interface Props {
  lede: string;
  stats?: Stat[];
  founded: string;
  /** Tina metadata-bearing data object for field markers. */
  data?: Record<string, unknown>;
}
const { lede, stats, founded, data } = Astro.props;

// 5 team moments, no trophy, no individual — auto-rotating, see slideshow notes.
// All are genuine multi-player shots (3–11 players), not portraits.
// Sources all CLIENT_REQ_010 / EV-20260826-032 or owner-confirmed banner assets
// (gallery-04/-08) — no third-party watermark is scrubbed; owner confirmed
// publication rights where a mark exists (see MANIFEST.md).
const TEAM_SLIDES = [
  {
    src: '/media/team-huddle.webp',
    width: 1080,
    height: 720,
    alt: 'UK Bangla Tigers squad in a team huddle on the field',
  },
  {
    src: '/media/team-night-action.webp',
    width: 1132,
    height: 720,
    alt: 'UK Bangla Tigers bowler appealing during a night match with teammates in frame',
  },
  {
    src: '/media/gallery-04.webp',
    width: 1400,
    height: 934,
    alt: 'UK Bangla Tigers match action with bowler delivering and batters at the crease',
  },
  {
    src: '/media/gallery-08.webp',
    width: 1400,
    height: 933,
    alt: 'UK Bangla Tigers squad team photo in light blue kit on the field',
  },
  {
    src: '/media/gallery-09.webp',
    width: 1400,
    height: 933,
    alt: 'UK Bangla Tigers batters together at the crease during a match',
  },
];
---

<div class="ukbt-about">
  <div
    class="ukbt-about__slideshow"
    role="region"
    aria-roledescription="carousel"
    aria-label="UK Bangla Tigers team moments"
    data-slideshow
  >
    <div class="ukbt-about__slides">
      {
        TEAM_SLIDES.map((s, i) => (
          <div
            class={`ukbt-about__slide${i === 0 ? ' is-active' : ''}`}
            data-slide={i}
            aria-hidden={i === 0 ? 'false' : 'true'}
            aria-label={`Team photo ${i + 1} of ${TEAM_SLIDES.length}`}
          >
            <img
              src={s.src}
              width={s.width}
              height={s.height}
              alt={s.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
            />
          </div>
        ))
      }
    </div>
    <div class="ukbt-about__dots" role="tablist" aria-label="Team photo navigation">
      {
        TEAM_SLIDES.map((_, i) => (
          <button
            type="button"
            class={`ukbt-about__dot${i === 0 ? ' is-active' : ''}`}
            role="tab"
            aria-label={`Go to team photo ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-dot={i}
          />
        ))
      }
    </div>
    <p class="ukbt-about__live sr-only" aria-live="polite" aria-atomic="true" />
  </div>
  <div class="ukbt-about__content">
    <h2 class="ukbt-about__headline">A Club With<br />Purpose</h2>
    <p class="ukbt-about__lede" data-tina-field={tinaField(data, "clubIntroLede")}>{lede}</p>
    <p class="ukbt-about__founded">Founded in {founded}.</p>
    {stats && stats.length > 0 && (
      <div class="ukbt-about__stats">
        {
          stats.map((s) => (
            <div class="ukbt-about__stat">
              <span class="ukbt-about__stat-value">{s.value}</span>
              <span class="ukbt-about__stat-label">{s.label}</span>
            </div>
          ))
        }
      </div>
    )}
  </div>
</div>

<style>
  .ukbt-about {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-5);
  }
  /* Slideshow — team-only, auto-rotating, accessible */
  .ukbt-about__slideshow {
    position: relative;
    width: 100%;
    border-radius: var(--ukbt-radius-ref-card);
    overflow: hidden;
    background: var(--ukbt-color-brand-primary);
  }
  /* Aspect-ratio via padding-bottom hack: bulletproof across all browsers
     and immune to the max-height / aspect-ratio interaction bug that
     leaves cream gaps at wide viewports. 3:2 matches the widest common
     cricket photo ratio. */
  .ukbt-about__slides {
    position: relative;
    width: 100%;
    padding-bottom: 66.67%;
    overflow: hidden;
  }
  .ukbt-about__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--ukbt-motion-duration-slow) var(--ukbt-motion-easing-standard);
    pointer-events: none;
  }
  .ukbt-about__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .ukbt-about__slide img {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .ukbt-about__dots {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 1;
    padding: 6px 10px;
    border-radius: var(--ukbt-radius-pill);
    background: rgba(var(--ukbt-color-brand-primary-rgb, 0, 30, 58), 0.28);
    backdrop-filter: blur(6px);
  }
  /* 24x24 hit area (WCAG 2.5.8 floor) with the 8px visual dot centred
     via ::after, so the pill stays compact while the target passes. */
  .ukbt-about__dot {
    position: relative;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition:
      background var(--ukbt-motion-duration-fast) var(--ukbt-motion-easing-standard),
      transform var(--ukbt-motion-duration-fast) var(--ukbt-motion-easing-standard);
  }
  .ukbt-about__dot::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 1px solid rgba(var(--ukbt-color-neutral-0-rgb, 255, 255, 255), 0.9);
    background: rgba(var(--ukbt-color-neutral-0-rgb, 255, 255, 255), 0.45);
    transition: inherit;
  }
  .ukbt-about__dot.is-active::after {
    background: var(--ukbt-color-neutral-0);
    transform: scale(1.25);
  }
  .ukbt-about__dot:focus-visible {
    outline: 2px solid var(--ukbt-color-brand-accent);
    outline-offset: 2px;
  }
  /* visually-hidden live region */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .ukbt-about__slide {
      transition: none;
    }
  }
  /* legacy image hooks removed — no route references them */
  .ukbt-about__content {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-4);
    max-width: 48rem;
  }
  .ukbt-about__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-about__lede {
    font-size: var(--ukbt-font-size-2);
    color: var(--ukbt-color-neutral-700);
    max-width: 40rem;
    margin: 0;
  }
  .ukbt-about__founded {
    color: var(--ukbt-color-neutral-700);
    margin: 0;
  }
  .ukbt-about__stats {
    display: flex;
    gap: var(--ukbt-space-gap-5);
    margin-top: var(--ukbt-space-4);
  }
  .ukbt-about__stat {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
    border-top: 2px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-2);
    min-width: 6rem;
  }
  .ukbt-about__stat-value {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-4);
    font-weight: var(--ukbt-font-weight-bold);
    color: var(--ukbt-color-brand-primary);
  }
  .ukbt-about__stat-label {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }

  /* bridge removed for budget — continuity via hero line only */

  @media screen and (max-width: 767px) {
    .ukbt-about__slides {
      padding-bottom: 75%;
    }
    .ukbt-about__stats {
      flex-direction: column;
      gap: var(--ukbt-space-4);
    }
  }
</style>

<script>
  // Auto-slideshow: 5 team slides, ~4s per slide, pause on hover/focus/hidden/reduced-motion.
  // No external deps; runs once per ClubIntro instance (homepage has one).
  (function () {
    const root = document.querySelector('[data-slideshow]');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const live = root.querySelector('.ukbt-about__live');
    if (slides.length <= 1) return;

    let index = 0;
    let timer: number | null = null;
    const INTERVAL = 4000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(n: number) {
      index = (n + slides.length) % slides.length;
      slides.forEach((el, i) => {
        const active = i === index;
        el.classList.toggle('is-active', active);
        el.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((el, i) => {
        const active = i === index;
        el.classList.toggle('is-active', active);
        el.setAttribute('aria-selected', active ? 'true' : 'false');
        el.setAttribute('tabindex', active ? '0' : '-1');
      });
      if (live) live.textContent = `Team photo ${index + 1} of ${slides.length}`;
    }

    function start() {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => show(index + 1), INTERVAL);
    }
    function stop() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    dots.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        show(i);
        start();
      });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    // Keyboard: arrow keys when dots have focus
    root.addEventListener('keydown', (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'ArrowRight') {
        ke.preventDefault();
        show(index + 1);
        start();
      } else if (ke.key === 'ArrowLeft') {
        ke.preventDefault();
        show(index - 1);
        start();
      }
    });

    show(0);
    start();
  })();
</script>