---
// Hero — photographic team backdrop under a navy scrim, with the
// editorial type composition on top. Two-slide auto-crossfade between
// the two cleared landscape TEAM photos (team-huddle.webp +
// team-night-action.webp, both client-authorised — see
// src/assets/MANIFEST.md for the provenance caveat; single-player
// shots, squad portraits and reviewed-and-rejected gallery frames are
// never used here). No crest here: brand identity already anchors the
// header, and a repeated mark would compete with the headline.
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  taglineShort: string;
  social: { platform: string; url: string }[];
  /** Club-identity eyebrow above the headline. Omitted by default. */
  eyebrow?: string;
  /** Secondary action beside the primary CTA. Omitted by default. */
  secondaryCta?: { label: string; href: string };
  /** Hero headline — overrides default when provided. */
  headline?: string;
  /** Primary CTA label — overrides default when provided. */
  primaryCtaLabel?: string;
  /** Primary CTA link — overrides default when provided. */
  primaryCtaLink?: string;
  /** Hero background image path — overrides default when provided. */
  heroImage?: string;
}
const {
  taglineShort,
  social,
  eyebrow,
  secondaryCta,
  headline = "We're not just\na team.",
  primaryCtaLabel = 'Join the Club',
  primaryCtaLink = '/join',
  heroImage = '/media/team-huddle.webp',
} = Astro.props;
---

<div class="ukbt-hero">
  <img
    src={heroImage}
    width="1080"
    height="720"
    alt=""
    fetchpriority="high"
    class="ukbt-hero__bg"
  />
  <img
    src="/media/team-night-action.webp"
    width="1132"
    height="720"
    alt=""
    fetchpriority="low"
    class="ukbt-hero__bg ukbt-hero__bg--alt"
  />
  <div class="ukbt-hero__scrim" aria-hidden="true"></div>
  <!-- Field Continuity — cricket-ground geometry as editorial depth (Concept B).
       Two SVG layers: boundary arc + pitch/crease. Pure CSS animation,
       transform/opacity only, token-driven, static under reduced motion.
       Decorative: aria-hidden, no layout impact. -->
  <div class="ukbt-hero__field" aria-hidden="true" style="animation:ukbt-hero-rise var(--ukbt-motion-duration-signature) var(--ukbt-motion-easing-emphasized) 200ms backwards">
    <svg class="ukbt-hero__field-svg" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" focusable="false" style="opacity:0.70">
      <!-- Boundary arc — outer stadium ellipse, very low opacity -->
      <ellipse cx="600" cy="820" rx="780" ry="520" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.14"></ellipse>
      <!-- Inner field arc -->
      <ellipse cx="600" cy="820" rx="540" ry="360" fill="none" stroke="currentColor" stroke-width="1" opacity="0.10"></ellipse>
      <!-- Pitch rectangle -->
      <rect x="540" y="360" width="120" height="220" rx="2" fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.18"></rect>
      <!-- Crease lines -->
      <line x1="540" y1="405" x2="660" y2="405" stroke="currentColor" stroke-width="0.9" opacity="0.20"></line>
      <line x1="540" y1="535" x2="660" y2="535" stroke="currentColor" stroke-width="0.9" opacity="0.20"></line>
      <!-- Centre line -->
      <line x1="600" y1="360" x2="600" y2="580" stroke="currentColor" stroke-width="0.6" opacity="0.10"></line>
    </svg>
  </div>
  <div class="ukbt-hero__continuity" aria-hidden="true" style="animation:ukbt-hero-rise var(--ukbt-motion-duration-slow) var(--ukbt-motion-easing-emphasized) 550ms backwards"></div>
  <div class="ukbt-container ukbt-hero__inner">
    <div class="ukbt-hero__content">
      {eyebrow && <p class="ukbt-hero__eyebrow ukbt-eyebrow ukbt-eyebrow--on-dark" data-tina-field="eyebrow">{eyebrow}</p>}
      <h1 class="ukbt-hero__headline" data-tina-field="headline">
        {headline.split('\n').map((line, i) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </h1>
      <p class="ukbt-hero__tagline" data-tina-field="tagline">{taglineShort}</p>
      <div class="ukbt-hero__actions">
        <Button label={primaryCtaLabel} href={primaryCtaLink} variant="primary" data-tina-field="primaryCtaLabel" />
        {secondaryCta && (
          <Button label={secondaryCta.label} href={secondaryCta.href} variant="secondary" />
        )}
      </div>
      <div class="ukbt-hero__social">
        <SocialLinks links={social} tone="on-dark" iconsOnlyOnMobile={true} />
      </div>
    </div>
  </div>
</div>

<style>
  .ukbt-hero {
    position: relative;
    overflow: hidden;
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    --ukbt-color-focus-ring: var(--ukbt-color-brand-accent);
  }
  /* Team photograph, cover-cropped with the huddle mass kept in frame.
     An <img> (not a CSS background) so the LCP element keeps
     fetchpriority and intrinsic dimensions. Decorative: empty alt. */
  .ukbt-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 35%;
    /* Cinematic settle, finite: scale rests at 1 and never loops. */
    animation: ukbt-hero-settle var(--ukbt-motion-duration-signature)
      var(--ukbt-motion-easing-emphasized) backwards;
  }
  @keyframes ukbt-hero-settle {
    from {
      transform: scale(1.04);
    }
  }
  /* Second slide of the background crossfade (team-night-action.webp,
     the only other cleared landscape team photo — MANIFEST.md). Slide
     1 stays static underneath; this layer fades in, rests ~6s, fades
     out on the slideshow token cycle — opacity only (never transform:
     the settle scale above already owns transform on its own layer).
     First frame and every animations-disabled screenshot show slide 1,
     so visual baselines stay deterministic. */
  .ukbt-hero__bg--alt {
    object-position: 50% 35%;
    /* Base state is slide 1: without animation (no-JS, old browsers,
       animations-disabled screenshots) this layer stays hidden rather
       than covering slide 1 at full opacity. */
    opacity: 0;
    animation: ukbt-hero-crossfade var(--ukbt-motion-duration-slideshow)
      var(--ukbt-motion-easing-standard) infinite;
  }
  @keyframes ukbt-hero-crossfade {
    0%,
    37.5% {
      opacity: 0;
    }
    50%,
    87.5% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ukbt-hero__bg--alt {
      animation: none;
      opacity: 0;
    }
  }

  /* Signature entrance: image → headline → tagline → CTA → social,
     overlapping, transform/opacity only. `backwards` fill stages each
     element off-screen-state during its delay — content is never hidden
     without the animation (no-JS renders it statically). */
  .ukbt-hero__eyebrow,
  .ukbt-hero__headline,
  .ukbt-hero__tagline,
  .ukbt-hero__actions,
  .ukbt-hero__social {
    animation: ukbt-hero-rise var(--ukbt-motion-duration-slow)
      var(--ukbt-motion-easing-emphasized) backwards;
  }
  .ukbt-hero__eyebrow {
    animation-delay: 150ms;
  }
  .ukbt-hero__headline {
    animation-delay: 250ms;
  }
  .ukbt-hero__tagline {
    animation-delay: 350ms;
  }
  .ukbt-hero__actions {
    animation-delay: 500ms;
  }
  .ukbt-hero__social {
    animation-delay: 650ms;
  }
  @keyframes ukbt-hero-rise {
    from {
      opacity: 0;
      transform: translateY(var(--ukbt-motion-distance-md));
    }
  }
  /* Legibility scrim, darkest where the type sits (left). Mixed from the
     surface-inverse token — no literal colour values (color-mix has
     precedent in Footer.astro). */
  .ukbt-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--ukbt-color-surface-inverse) 93%, transparent) 0%,
      color-mix(in srgb, var(--ukbt-color-surface-inverse) 82%, transparent) 45%,
      color-mix(in srgb, var(--ukbt-color-surface-inverse) 60%, transparent) 100%
    );
  }
  .ukbt-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    /* First-viewport fill: header heights are deterministic from this
       system's own bar geometry (logo + padding-block) — 88px at <=430px
       (48px logo + 2x20px pad), 100px below 768px (60px logo + 2x20px
       pad), 140px at >=768px (60px logo + 2x40px pad). vh first as the
       fallback, svh for browsers with dynamic chrome. min-height, never
       height, so short viewports still grow to fit the content. */
    min-height: calc(100vh - 100px);
    min-height: calc(100svh - 100px);
    padding-block: var(--ukbt-space-section-padding);
  }
  @media screen and (max-width: 430px) {
    .ukbt-hero__inner {
      min-height: calc(100vh - 88px);
      min-height: calc(100svh - 88px);
    }
  }
  @media screen and (min-width: 768px) {
    .ukbt-hero__inner {
      min-height: calc(100vh - 140px);
      min-height: calc(100svh - 140px);
    }
  }
  /* At >=1280px the header CTA pill (~62px) is 2px taller than the 60px
     logo, stretching the bar from 140px to 142px (measured). */
  @media screen and (min-width: 1280px) {
    .ukbt-hero__inner {
      min-height: calc(100vh - 142px);
      min-height: calc(100svh - 142px);
    }
  }
  .ukbt-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ukbt-space-4);
    max-width: 48rem;
  }
  .ukbt-hero__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .ukbt-hero__tagline {
    font-family: var(--ukbt-font-family-heading);
    color: var(--ukbt-color-brand-accent);
    font-size: var(--ukbt-font-size-2);
    font-weight: 600;
    margin: 0;
  }
  .ukbt-hero__actions {
    margin-top: var(--ukbt-space-2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ukbt-space-3);
  }
  /* NOTE: a :global(.ukbt-button--primary) recolor lived here until the
     homepage-enhancement pass — it restated Button's own default values
     verbatim (gold pill), so deleting it is pixel-identical. Light-surface
     navy pills are now Button tone="on-light", owned by the component. */
  .ukbt-hero__social {
    margin: var(--ukbt-space-4) 0 0 0;
  }

  /* Field geometry — cricket depth (Concept B). Minimal positioning;
     entrance reuses existing ukbt-hero-rise via inline style so no new
     keyframes are emitted. */
  .ukbt-hero__field {
    position: absolute;
    inset: 0;
    z-index: 0;
    color: var(--ukbt-color-brand-accent);
    pointer-events: none;
  }
  .ukbt-hero__field-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .ukbt-hero__continuity {
    position: absolute;
    left: var(--ukbt-space-section-wrapper, 24px);
    right: var(--ukbt-space-section-wrapper, 24px);
    bottom: 0;
    height: 1px;
    z-index: 1;
    background: var(--ukbt-color-brand-accent);
    opacity: 0.22;
  }
  @media screen and (max-width: 767px) {
    .ukbt-hero__continuity {
      left: var(--ukbt-space-section-wrapper-sm, 16px);
      right: var(--ukbt-space-section-wrapper-sm, 16px);
    }
    .ukbt-hero__headline {
      font-size: clamp(2rem, 1.2rem + 4vw, 3rem);
    }
    /* Match the Section component's mobile step-down (120px -> 80px) so
       padding doesn't consume the small-viewport hero. */
    .ukbt-hero__inner {
      padding-block: 80px;
    }
    /* Portrait crop: bias toward the players (right of frame) and deepen
       the scrim so type stays legible over a narrower photo slice. */
    .ukbt-hero__bg {
      object-position: 72% 30%;
    }
    .ukbt-hero__scrim {
      background: linear-gradient(
        100deg,
        color-mix(in srgb, var(--ukbt-color-surface-inverse) 95%, transparent) 0%,
        color-mix(in srgb, var(--ukbt-color-surface-inverse) 88%, transparent) 60%,
        color-mix(in srgb, var(--ukbt-color-surface-inverse) 72%, transparent) 100%
      );
    }
  }
</style>
