---
// Mirrors the reference's "About Welcome Section": `.welcome-about-wrapper`
// (grid-template-columns: 0.42fr 0.52fr, gap 100px) heading/intro pair,
// followed by a 4-card fact row (`.card-about-misson`: column card, image
// + content block). Reimplemented with four real, independently
// evidenced UKBT facts — not Adelux's mission-card copy, and not
// invented differentiators. The reference's partner-logo swiper
// (`.partnership-container`) is its own component (Sponsors.astro,
// rendered directly after this one on /about) — omitted from here only,
// not from the page; see Sponsors.astro's header for why it isn't
// merged into this component instead.
interface Fact {
  title: string;
  body: string;
}
interface Props {
  tagline: string;
  facts: Fact[];
}
const { tagline, facts } = Astro.props;
import SubHeading from './SubHeading.astro';
---

<div class="ukbt-mission">
  <div class="ukbt-mission__intro">
    <div class="ukbt-mission__heading">
      <SubHeading label="Welcome to UK Bangla Tigers" />
      <h2>Where Passion Meets the Pitch</h2>
    </div>
    <p class="ukbt-mission__lede">{tagline}</p>
  </div>

  <div class="ukbt-mission__facts">
    {
      facts.map((f) => (
        <div class="ukbt-mission__fact">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* Reference `.welcome-about-wrapper` is a 0.42fr/0.52fr end-aligned
     heading/intro pair — but with a 4-line display H2 beside a
     single-line lede it strands the tagline bottom-right,
     disconnected from the heading it belongs to (render-verified at
     1440). Deviation, owner direction 2026-09-11: stacked intro —
     eyebrow + H2, then the lede full-width at paragraph measure.
     Same grammar as every other section header on the page; the
     ≤1025px stacking rule this replaces is now the only layout. */
  .ukbt-mission__intro {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-4);
  }
  .ukbt-mission__heading h2 {
    margin: var(--ukbt-space-2) 0 0 0;
    text-wrap: balance;
  }
  .ukbt-mission__lede {
    margin: 0;
    max-width: 48rem;
    font-size: var(--ukbt-font-body-paragraph-size);
    line-height: var(--ukbt-font-line-height-body);
    color: var(--ukbt-color-neutral-700);
  }

  /* .card-about-misson row: 4-up card grid */
  .ukbt-mission__facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--ukbt-space-4);
    margin-top: var(--ukbt-space-8);
  }
  .ukbt-mission__fact {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-2);
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-lg);
    padding: var(--ukbt-space-4);
    border-top: 3px solid var(--ukbt-color-brand-accent);
  }
  /* Promoted from h4 to h3 (mobile axe-core sweep across all 16 routes:
     these facts sit directly after this component's own h2 above, with
     no h3 between). Explicit size keeps the pre-existing visual weight. */
  .ukbt-mission__fact h3 {
    margin: 0;
    font-size: var(--ukbt-font-size-1);
  }
  .ukbt-mission__fact p {
    margin: 0;
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }

  @media screen and (max-width: 1025px) {
    .ukbt-mission__intro {
      gap: var(--ukbt-space-gap-5);
    }
  }
  /* A4: 4-up squeezes to micro-type at 768px (measured); 1024 fits
     and <=767 already stacks, so 2-up applies only <=900px. */
  @media screen and (max-width: 900px) {
    .ukbt-mission__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 479px) {
    .ukbt-mission__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
