---
// Footer — final brand statement. Uses shared NavItem type.
// Editorial composition: brand identity, quick links, contact, follow.
import type { NavItem } from '@ukbt/truth';
import Link from './Link.astro';
import SocialLinks from './SocialLinks.astro';
// Site-wide club contact channels — from Tina siteSettings when available,
// falling back to truth-gated homepage-data.
import { contact } from '../content/homepage-data';
import { tinaSite } from '../lib/tina/loaders';

interface SocialLink {
  platform: string;
  url: string;
}
interface Props {
  social: SocialLink[];
  nav: NavItem[];
  secondaryNav?: NavItem[];
}
const { social, nav, secondaryNav = [] } = Astro.props;

const footerTagline = tinaSite.footerTagline || tinaSite.siteTaglineShort;
const footerContact = tinaSite.contact || contact;

const year = new Date().getFullYear();
---

<footer class="ukbt-footer">
  <div class="ukbt-container ukbt-footer__inner">
    <div class="ukbt-footer__columns" data-motion="reveal">
      <div class="ukbt-footer__col ukbt-footer__col--brand">
        <img src="/brand/crest-256.webp" width="53" height="72" alt="" class="ukbt-footer__logo" loading="lazy" />
        <p class="ukbt-footer__tagline">{footerTagline}</p>
      </div>

      <div class="ukbt-footer__col">
        <h3>Quick Links</h3>
        <nav aria-label="Footer">
          <ul class="ukbt-footer__links">
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            {secondaryNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </div>

      <div class="ukbt-footer__col">
        <h3>Get in Touch</h3>
        <p class="ukbt-footer__note">
          Questions about the club, fixtures or joining.
        </p>
        <ul class="ukbt-footer__contact">
          <li>
            <a href={`mailto:${footerContact.email}`}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-10 6L2 7" />
              </svg>
              <span>{footerContact.email}</span>
            </a>
          </li>
          <li>
            <a href={footerContact.phoneHref}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              <span>{footerContact.phoneDisplay}</span>
            </a>
          </li>
        </ul>
        <span class="ukbt-footer__contact-link"><Link href="/contact/" tone="on-dark" emphasis="strong">Contact us &rarr;</Link></span>
      </div>

      <div class="ukbt-footer__col">
        <h3>Follow the Tigers</h3>
        <p class="ukbt-footer__note">
          Every match, signing and tournament, straight from the club.
        </p>
        <SocialLinks links={social} tone="on-dark" direction="column" />
      </div>
    </div>

    <div class="ukbt-footer__copyright">
      <p>&copy; {year} UK Bangla Tigers</p>
      <p class="ukbt-footer__entity">UK Bangla Tigers Cricket Club CIC</p>
    </div>
  </div>
</footer>

<style>
  .ukbt-footer {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
  }
  .ukbt-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-5);
    padding-block: var(--ukbt-space-section-padding) 0;
  }
  .ukbt-footer__columns {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: var(--ukbt-space-gap-5);
  }
  .ukbt-footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-2);
  }
  .ukbt-footer__col--brand {
    gap: var(--ukbt-space-gap-3);
  }
  .ukbt-footer__col h3 {
    margin: 0;
    font-size: var(--ukbt-font-size-1);
    font-weight: 600;
  }
  .ukbt-footer__col p {
    margin: 0;
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-300);
  }
  .ukbt-footer__logo {
    height: 72px;
    width: auto;
    align-self: flex-start;
  }
  .ukbt-footer__tagline {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-1);
    font-weight: 600;
    color: var(--ukbt-color-surface-inverse-foreground);
  }
  /* links + contact lists share one rule: identical column rhythm
     (deduped during the captain pass to fund evidence-backed rules
     within the CSS budget — zero computed change). */
  .ukbt-footer__links,
  .ukbt-footer__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-1);
  }
  .ukbt-footer__links a {
    color: var(--ukbt-color-neutral-300);
    text-decoration: none;
    font-size: var(--ukbt-font-size-0);
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .ukbt-footer__links a:hover {
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-footer__contact-link {
    align-self: flex-start;
  }
  /* Direct channels: compact symbol + text rows in the Get in Touch
     column. Same tone treatment as the footer quick links
     (neutral-300, gold on hover), 24px minimum hit area. List rhythm
     comes from the shared rule above. */
  .ukbt-footer__contact a {
    color: var(--ukbt-color-neutral-300);
    text-decoration: none;
    font-size: var(--ukbt-font-size-0);
    display: inline-flex;
    align-items: center;
    gap: var(--ukbt-space-gap-1);
    min-height: 24px;
    overflow-wrap: anywhere;
  }
  .ukbt-footer__contact a:hover {
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-footer__contact svg {
    flex: none;
  }
  .ukbt-footer__note {
    max-width: 24rem;
  }
  .ukbt-footer__copyright {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--ukbt-space-gap-2);
    justify-content: space-between;
    padding-block: var(--ukbt-space-gap-3);
    border-top: 1px solid color-mix(in srgb, var(--ukbt-color-neutral-0) 25%, transparent);
  }
  .ukbt-footer__copyright p {
    margin: 0;
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-300);
  }
  .ukbt-footer a:focus-visible {
    outline: 2px solid var(--ukbt-color-brand-accent);
    outline-offset: 2px;
  }

  @media screen and (max-width: 1025px) {
    .ukbt-footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--ukbt-space-gap-5);
    }
  }
  @media screen and (max-width: 767px) {
    .ukbt-footer__columns {
      grid-template-columns: 1fr;
    }
  }
</style>
