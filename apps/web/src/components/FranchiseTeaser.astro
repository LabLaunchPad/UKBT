---
// FranchiseTeaser — re-art-directed. Clean editorial row, not a two-column card.
// One crest, one sentence. Typography + space, not decorative panels.
interface Props {
  name: string;
}
const { name } = Astro.props;

import Link from './Link.astro';
import { uppsalaOverseasSignings } from '../content/franchises-data';

const overseasCountries = [
  ...new Set(uppsalaOverseasSignings.map((p) => p.country).filter((c): c is string => Boolean(c))),
];
const countryList =
  overseasCountries.length > 1
    ? `${overseasCountries.slice(0, -1).join(', ')} and ${overseasCountries.at(-1)}`
    : (overseasCountries[0] ?? '');
---

<div class="ukbt-franchise">
  <div class="ukbt-franchise__crest">
    <img src="/brand/uppsala-tigers-crest.jpg" width="110" height="110" alt="Uppsala Tigers crest" loading="lazy" />
  </div>
  <div class="ukbt-franchise__content">
    <h3 class="ukbt-franchise__headline">One Tigers Family,<br />Two Nations</h3>
    <p class="ukbt-franchise__body">
      UK Bangla Tigers' sister franchise, <strong>{name}</strong>, based in Sweden, competing in the Nordic Smash T20.
      Fields international players from {countryList}.
    </p>
    <span class="ukbt-franchise__link-wrap"><Link href="/franchises/">See the franchise &rarr;</Link></span>
  </div>
</div>

<style>
  /* Captain → Franchise transition fix: the flat-white teaser follows
     the cream captain panel with only whitespace between them, which
     read as a trough. A gold top rule (same grammar as AboutCTA's)
     gives the network story a deliberate boundary without adding
     weight elsewhere — crest scale +1rem completes the lockup. */
  .ukbt-franchise {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--ukbt-space-gap-100);
    border-top: 3px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-6);
  }
  .ukbt-franchise__crest {
    flex-shrink: 0;
  }
  .ukbt-franchise__crest img {
    display: block;
    height: 9rem;
    width: auto;
  }
  .ukbt-franchise__content {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
  }
  .ukbt-franchise__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-franchise__body {
    font-size: var(--ukbt-font-size-1);
    color: var(--ukbt-color-neutral-700);
    max-width: 40rem;
    margin: 0;
  }
  .ukbt-franchise__link-wrap {
    margin-top: var(--ukbt-space-1);
  }

  @media screen and (max-width: 767px) {
    .ukbt-franchise {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--ukbt-space-6);
    }
    .ukbt-franchise__crest img {
      height: 6rem;
    }
  }
</style>
