---
// AboutCTA — re-art-directed. Clean editorial CTA, not two-column card.
// Statement + CTA + social links as a typographic row. About Phase 1
// (legacy S4 port): gold Contact Us pill beside Follow (routes to the
// already-authorised /contact route) + cleared team-huddle photo below.
import Button from './Button.astro';
import SocialLinks, { socialDisplayName } from './SocialLinks.astro';

interface Social {
  platform: string;
  url: string;
}
interface Props {
  social: Social[];
  /** Navy-finale mode: white-on-navy re-set, gold buttons, no top rule,
     photo hoisted to the calling page. Homepage band 7 only. */
  inverse?: boolean;
}
const { social, inverse = false } = Astro.props;
const primarySocial = social[0];
---

<div class={inverse ? 'ukbt-about-cta ukbt-about-cta--inverse' : 'ukbt-about-cta'}>
  <div class="ukbt-about-cta__content">
    <h3 class="ukbt-about-cta__headline">Follow the Tigers</h3>
    <p class="ukbt-about-cta__body ukbt-about-cta__lede">Every tournament, every result — straight from the club.</p>
    <div class="ukbt-about-cta__actions">
      {primarySocial && (
        <Button
          label={`Follow on ${socialDisplayName(primarySocial.platform)}`}
          href={primarySocial.url}
          variant="primary"
          tone={inverse ? 'on-dark' : 'on-light'}
          external
        />
      )}
      <Button label="Contact Us" href="/contact/" variant="primary" tone={inverse ? 'on-dark' : 'on-light'} />
      {inverse && (
        <a class="ukbt-about-cta__join" href="/join/">Join the Club</a>
      )}
    </div>
  </div>
  <div class="ukbt-about-cta__social">
    <span class="ukbt-about-cta__social-label ukbt-about-cta__lede">Also on</span>
    <SocialLinks links={social} tone={inverse ? 'on-dark' : 'on-light'} label="UK Bangla Tigers on other platforms" />
  </div>
  {!inverse && (
  <div class="ukbt-about-cta__photo">
    <img
      src="/media/team-huddle.webp"
      width="1080"
      height="720"
      alt="UK Bangla Tigers players in a team huddle"
      loading="lazy"
    />
  </div>
  )}
</div>

<style>
  .ukbt-about-cta {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-5);
    border-top: 3px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-6);
  }
  /* Navy-finale (inverse) mode — homepage band 7 only. The Section
     repaints text to inverseForeground and the focus ring gold; body
     and social-label step to neutral-300 (SectionHeader inverse-lede
     precedent); the light-surface top rule is absorbed by the band
     boundary so no rule sits on navy. */
  .ukbt-about-cta--inverse {
    border: 0;
  }
  .ukbt-about-cta--inverse .ukbt-about-cta__lede {
    color: var(--ukbt-color-neutral-300);
  }
  /* Inherits the Section inverse foreground (Section.astro repaints the
     container, nothing between sets a colour); identical computed value
     to the explicit token at far fewer bytes (perf budget). */
  .ukbt-about-cta__join {
    align-self: center;
    color: inherit;
    text-underline-offset: var(--ukbt-space-1);
  }
  .ukbt-about-cta__content {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    align-items: flex-start;
    max-width: 36rem;
  }
  .ukbt-about-cta__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-about-cta__body {
    margin: 0;
    font-size: var(--ukbt-font-size-2);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-about-cta__actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--ukbt-space-3);
  }
  .ukbt-about-cta__social {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-2);
  }
  .ukbt-about-cta__social-label {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }
  /* D4 audit: at desktop widths the full-bleed slot crops the 3:2
     source to a thin band. Cap the frame so the team stays in view. */
  .ukbt-about-cta__photo {
    max-width: 48rem;
  }
  .ukbt-about-cta__photo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 28rem;
    object-fit: cover;
    border-radius: var(--ukbt-radius-ref-card);
  }
</style>
