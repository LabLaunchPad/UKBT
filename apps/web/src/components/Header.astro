---
// Site header with dropdown navigation support.
// Parent items with children remain navigable — clicking the label navigates
// to the href, clicking the arrow/toggle opens the submenu.
// Dropdowns support mouse, keyboard (Enter, Space, ArrowDown, ArrowUp, Escape)
// and touch (accordion on mobile).
import type { NavItem } from '@ukbt/truth';
import Button from './Button.astro';

interface Props {
  nav: NavItem[];
  cta?: { label: string; href: string };
}
const { nav, cta } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<a href="#main-content" class="ukbt-skip-link">Skip to main content</a>

<header class="ukbt-header" id="ukbt-header">
  <div class="ukbt-container ukbt-header__bar">
    {/*
      Shared-element brand continuity: the anchor (not the img) carries
      the transition name, so exactly one `ukbt-site-logo` exists per
      page — the drawer crest stays unnamed. Same geometry everywhere
      (44x60 in a stable header bar), so the morph is a calm crossfade
      that keeps the brand planted across navigation. Drawer
      open/closed state still resets via the after-swap handler below.
    */}
    <a
      href="/"
      class="ukbt-header__brand"
      aria-label="UK Bangla Tigers — home"
      transition:name="ukbt-site-logo"
    >
      <img
        src="/brand/crest-256.webp"
        width="44"
        height="60"
        alt=""
        class="ukbt-header__logo"
      />
    </a>

    <nav class="ukbt-header__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item, i) => (
            <li class:list={[item.children && 'ukbt-header__nav-item--has-dropdown']}>
              <a
                href={item.href}
                aria-label={item.ariaLabel}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  class="ukbt-header__dropdown-toggle"
                  aria-expanded="false"
                  aria-haspopup="menu"
                  aria-controls={`ukbt-dropdown-menu-${i}`}
                  aria-label={`${item.ariaLabel ?? item.label} submenu`}
                >
                  <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" />
                  </svg>
                </button>
              )}
              {item.children && (
                <ul class="ukbt-header__dropdown" role="menu" id={`ukbt-dropdown-menu-${i}`}>
                  {item.children.map((child) => (
                    <li role="none">
                      <a href={child.href} role="menuitem" aria-current={isActive(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ukbt-header__cta">
      {cta && <Button label={cta.label} href={cta.href} variant="primary" />}
    </div>

    <button
      type="button"
      id="ukbt-nav-toggle"
      class="ukbt-header__toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="ukbt-nav-drawer"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Off-canvas drawer (reference `.sidebar` + `.sidebar-overlay`) -->
  <div class="ukbt-header__overlay" id="ukbt-nav-overlay"></div>
  <div class="ukbt-header__drawer" id="ukbt-nav-drawer" role="dialog" aria-label="Site menu" aria-modal="true" inert>
    <div class="ukbt-header__drawer-head">
      <img src="/brand/crest-256.webp" width="44" height="60" alt="" />
      <button type="button" class="ukbt-header__close" id="ukbt-nav-close" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul class="ukbt-header__drawer-menu">
      {
        nav.map((item, i) => (
          <li
            class:list={[item.children && 'ukbt-header__drawer-item--has-children']}
            style={`--ukbt-motion-index: ${i}`}
          >
            {item.children ? (
              <div class="ukbt-header__drawer-group">
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                <button
                  type="button"
                  class="ukbt-header__drawer-accordion"
                  aria-expanded="false"
                  aria-label={`${item.label} submenu`}
                >
                  <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" />
                  </svg>
                </button>
              </div>
            ) : (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
            {item.children && (
              <ul class="ukbt-header__drawer-submenu">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Header controls, ClientRouter-proofed. A client navigation swaps the
  // header DOM out from under this script while `document` (and
  // `window`) persist — so NOTHING here may cache element references at
  // load: every handler re-queries fresh nodes per event, and every
  // listener is document-delegated behind a once-per-document window
  // guard (same pattern as BaseLayout's logo-intro wiring). The previous
  // version bound each control directly to its element at load, so the
  // hamburger worked exactly once per document load and went dead after
  // the first client-side navigation (reproduced at 390x844: toggle
  // inert post-nav, zero page errors).
  const w = window as unknown as Record<string, boolean | undefined>;
  if (!w['__ukbtHeaderWired']) {
    w['__ukbtHeaderWired'] = true;

    const headerEl = () => document.getElementById('ukbt-header');
    const toggleEl = () => document.getElementById('ukbt-nav-toggle');
    const drawerEl = () => document.getElementById('ukbt-nav-drawer');
    const isDrawerOpen = () =>
      toggleEl()?.getAttribute('aria-expanded') === 'true';

    function setOpen(open: boolean) {
      headerEl()?.classList.toggle('ukbt-header--open', open);
      toggleEl()?.setAttribute('aria-expanded', String(open));
      if (open) {
        drawerEl()?.removeAttribute('inert');
      } else {
        drawerEl()?.setAttribute('inert', '');
      }
      // Lock the page behind the drawer. Measured at 390x844: with the
      // drawer open, a scroll gesture moved the background from scrollY 0
      // to 700 while the menu stayed pinned — the page silently moved
      // under the overlay, so closing the menu returned the reader
      // somewhere they never navigated to.
      document.body.style.overflow = open ? 'hidden' : '';
    }

    function setDropdown(
      item: HTMLElement,
      open: boolean,
      opts: { refocus?: boolean } = {},
    ) {
      const btn = item.querySelector<HTMLElement>(
        '.ukbt-header__dropdown-toggle',
      );
      const menu = item.querySelector<HTMLElement>('.ukbt-header__dropdown');
      if (!btn || !menu) return;
      btn.setAttribute('aria-expanded', String(open));
      if (open) menu.setAttribute('aria-expanded', 'true');
      else menu.removeAttribute('aria-expanded');
      if (!open && opts.refocus) btn.focus();
    }

    function closeAllDropdowns(except?: HTMLElement) {
      document
        .querySelectorAll<HTMLElement>(
          '.ukbt-header__nav-item--has-dropdown',
        )
        .forEach((item) => {
          if (item !== except) {
            setDropdown(item, false);
            item.removeAttribute('data-opened-by');
          }
        });
    }

    function isDropdownOpen(item: HTMLElement) {
      return (
        item
          .querySelector('.ukbt-header__dropdown-toggle')
          ?.getAttribute('aria-expanded') === 'true'
      );
    }

    // ONE delegated click handler, ordered most-specific first. The old
    // code bound per element and relied on stopPropagation against a
    // separate document closer; ordering inside a single listener is the
    // same guarantee without the fragility.
    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (!el) return;
      const toggle = el.closest('#ukbt-nav-toggle');
      if (toggle) {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        return;
      }
      if (el.closest('#ukbt-nav-close') || el.closest('#ukbt-nav-overlay')) {
        closeAllDropdowns();
        setOpen(false);
        toggleEl()?.focus();
        return;
      }
      const ddToggle = el.closest('.ukbt-header__dropdown-toggle');
      if (ddToggle) {
        const item =
          ddToggle.closest<HTMLElement>(
            '.ukbt-header__nav-item--has-dropdown',
          );
        if (item) {
          // A real mouse click (e.detail > 0) that follows a hover-open
          // is a no-op keep-open: without this, moving the mouse onto
          // the chevron (mouseover opens) then clicking would instantly
          // close the menu just opened. Keyboard-synthesised clicks
          // (e.detail === 0) and touch taps always toggle.
          if (
            !(
              e.detail > 0 &&
              isDropdownOpen(item) &&
              item.getAttribute('data-opened-by') === 'hover'
            )
          ) {
            const willOpen = !isDropdownOpen(item);
            closeAllDropdowns(item);
            setDropdown(item, willOpen);
            item.setAttribute('data-opened-by', 'toggle');
          }
          return;
        }
      }
      const accordion = el.closest('.ukbt-header__drawer-accordion');
      if (accordion) {
        const submenu = accordion
          .closest('li')
          ?.querySelector('.ukbt-header__drawer-submenu');
        if (submenu) {
          const expanded = accordion.getAttribute('aria-expanded') === 'true';
          accordion.setAttribute('aria-expanded', String(!expanded));
          submenu.setAttribute('aria-expanded', String(!expanded));
        }
        return;
      }
      // Click anywhere else closes desktop dropdowns (the old standalone
      // document closer, folded in).
      closeAllDropdowns();
    });

    // Hover open/close on hover-capable devices only (touch uses tap).
    // mouseenter/leave don't bubble, so this uses mouseover/mouseout
    // with enter/leave-from-outside checks.
    if (window.matchMedia('(hover: hover)').matches) {
      document.addEventListener('mouseover', (e) => {
        const el = e.target instanceof Element ? e.target : null;
        const item = el?.closest<HTMLElement>(
          '.ukbt-header__nav-item--has-dropdown',
        );
        if (!item) return;
        const from =
          e.relatedTarget instanceof Element ? e.relatedTarget : null;
        if (from && item.contains(from)) return;
        closeAllDropdowns(item);
        if (!isDropdownOpen(item)) {
          setDropdown(item, true);
          item.setAttribute('data-opened-by', 'hover');
        }
      });
      document.addEventListener('mouseout', (e) => {
        const el = e.target instanceof Element ? e.target : null;
        const item = el?.closest<HTMLElement>(
          '.ukbt-header__nav-item--has-dropdown',
        );
        if (!item) return;
        const to = e.relatedTarget instanceof Element ? e.relatedTarget : null;
        if (to && item.contains(to)) return;
        setDropdown(item, false);
        item.removeAttribute('data-opened-by');
      });
    }

    // ONE delegated keydown handler: drawer Escape + focus trap (the
    // drawer declares aria-modal but Tab is not contained by ARIA
    // alone — measured at 390x844, focus escaped to main content),
    // plus dropdown trigger/menu keys. All nodes fresh per event.
    document.addEventListener('keydown', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (e.key === 'Escape') {
        if (isDrawerOpen()) {
          setOpen(false);
          toggleEl()?.focus();
          return;
        }
        const menu =
          el?.closest<HTMLElement>('.ukbt-header__dropdown');
        if (menu) {
          const item = menu.closest<HTMLElement>(
            '.ukbt-header__nav-item--has-dropdown',
          );
          if (item) setDropdown(item, false, { refocus: true });
          return;
        }
        const openItem = el?.closest<HTMLElement>(
          '.ukbt-header__nav-item--has-dropdown',
        );
        if (openItem && isDropdownOpen(openItem)) {
          e.preventDefault();
          setDropdown(openItem, false);
        }
        return;
      }
      if (e.key === 'Tab') {
        if (!isDrawerOpen()) return;
        const drawer = drawerEl();
        if (!drawer) return;
        const focusables = drawer.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
        );
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || !drawer.contains(active))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        const trigger = el?.closest('.ukbt-header__dropdown-toggle');
        if (trigger) {
          const item = trigger.closest<HTMLElement>(
            '.ukbt-header__nav-item--has-dropdown',
          );
          if (item) {
            e.preventDefault();
            closeAllDropdowns(item);
            setDropdown(item, true);
            item.setAttribute('data-opened-by', 'toggle');
            const links = item.querySelectorAll<HTMLElement>(
              '.ukbt-header__dropdown a[href]',
            );
            (e.key === 'ArrowDown' ? links[0] : links[links.length - 1])?.focus();
          }
          return;
        }
        const menu = el?.closest<HTMLElement>('.ukbt-header__dropdown');
        if (menu) {
          const items = menu.querySelectorAll<HTMLElement>('a[href]');
          const first = items[0];
          const last = items[items.length - 1];
          const active = document.activeElement;
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (active === last) first?.focus();
            else {
              const idx = Array.from(items).indexOf(active as HTMLElement);
              items[idx + 1]?.focus();
            }
          } else {
            e.preventDefault();
            if (active === first) last?.focus();
            else {
              const idx = Array.from(items).indexOf(active as HTMLElement);
              items[idx - 1]?.focus();
            }
          }
        }
      }
    });

    // Tabbing out of a dropdown item closes it (focusout bubbles, so
    // this delegates cleanly); focus never lingers invisibly inside a
    // closed menu.
    document.addEventListener('focusout', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      const item = el?.closest<HTMLElement>(
        '.ukbt-header__nav-item--has-dropdown',
      );
      if (item && !item.contains(e.relatedTarget as Node)) {
        setDropdown(item, false);
      }
    });

    // A swap must never land with a stuck-open drawer, a scroll-locked
    // body, or a lingering open menu from the previous page.
    document.addEventListener('astro:after-swap', () => {
      setOpen(false);
      closeAllDropdowns();
    });
  }
</script>

<style>
  .ukbt-header {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    position: relative;
    z-index: var(--ukbt-z-header);
  }
  /* Three explicit layout regions — brand | navigation | CTA — so the
     nav never competes with the CTA for the same flex space. The middle
     region is shrinkable (minmax 0) while brand and CTA keep intrinsic
     widths; the CTA is never squeezed. */
  .ukbt-header__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ukbt-space-gap-2);
    padding-block: var(--ukbt-space-gap-2);
    width: 100%;
  }
  /* Reference navbar padding steps with viewport (20px mobile / 40px
     tablet / 60px desktop — EV-20260826-032, reference-geometry.json
     navbar.padTop at 430/390, 1024/768, 1440/1280 respectively), giving
     measured heights of ~98-102px / 126-142px / 162px. The flat 20px
     used here previously matched only the mobile band, making the header
     37% shorter than the reference at desktop widths. Breakpoints reuse
     this component's own existing bands (768px = hero stack, 1280px =
     nav-collapse) rather than introducing new ones. */
  @media screen and (min-width: 768px) {
    .ukbt-header__bar {
      padding-block: var(--ukbt-space-gap-4);
    }
  }
  .ukbt-header__brand {
    display: flex;
    align-items: center;
    gap: var(--ukbt-space-gap-1);
    color: inherit;
    text-decoration: none;
    flex: none;
    grid-column: 1;
    justify-self: start;
  }
  /* One-time logo intro (first true document visit only — see
     BaseLayout's head script + swap lifecycle listeners). The brand
     settles from slightly above into its permanent place: transform +
     opacity only, end state identical to the static header. `backwards`
     holds the from-state for the first frame so the final logo never
     flashes before the animation starts. */
  html.ukbt-logo-intro .ukbt-header__brand {
    animation: ukbt-logo-intro var(--ukbt-motion-duration-intro)
      var(--ukbt-motion-easing-emphasized) backwards;
  }
  @keyframes ukbt-logo-intro {
    0% {
      opacity: 0.9;
      transform: translateY(-12px) scale(1.03);
    }
    70% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    85% {
      opacity: 1;
      transform: translateY(1px) scale(1);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @media screen and (max-width: 430px) {
    @keyframes ukbt-logo-intro {
      0% {
        opacity: 0.9;
        transform: translateY(-8px) scale(1.02);
      }
      70% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      85% {
        opacity: 1;
        transform: translateY(1px) scale(1);
      }
      100% {
        opacity: 1;
        transform: none;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.ukbt-logo-intro .ukbt-header__brand {
      animation: none;
    }
  }
  /* Full-artwork crest file (256x349): the square derivatives crop the
     shield's crown and base point. Displayed at 60px tall the width
     follows the true ratio (44px), matching the width/height attributes
     so there is no layout shift. */
  .ukbt-header__logo {
    height: 60px;
    width: auto;
    flex: none;
  }
  /* Compact brand at the smallest widths: the 60px crest plus bar
     padding consumes a disproportionate share of a 320px viewport. */
  @media screen and (max-width: 430px) {
    .ukbt-header__logo {
      height: 48px;
    }
  }
  /* The reference's own brand slot is a bare logo image with no text
     wordmark. Reproducing that is also what makes the bar fit: with a
     wordmark the three regions measured 1501px against a 1340px
     container (brand 246 + nav 1044 + CTA 211). The accessible name is
     carried by the link's aria-label. */

  .ukbt-header__nav {
    grid-column: 2;
    justify-self: center;
    min-width: 0;
  }
  /* Child combinator is load-bearing: a descendant selector here would
     also match the dropdown menus and force them into a horizontal flex
     row — items side-by-side, spilling past the menu box, both menus
     reading as one merged surface. The top-level row ONLY. */
  .ukbt-header__nav > ul {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Reference `.nav-link`: Montserrat 16px/600, padding 0 15px —
     block padding enlarged to 8px to meet WCAG 2.5.8 24px target-size
     (axe target-size: block with line-height 1 was only ~16px tall,
     20x24 measured, so links were partially obscured by their hit
     rect). Inline padding stays 15px: wider values push the 7-item
     row past its grid column at >1439px, sliding Home under the
     crest and Contact Us under the CTA (measured on localhost). */
  .ukbt-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-heading-h6-size);
    font-weight: var(--ukbt-font-weight-medium);
    line-height: 1;
    padding-block: 8px;
    padding-inline: 15px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  /* Child combinators are load-bearing here too: the dropdown menus
     render on the light surface-background, where gold text is 2.12:1
     (axe + gold-text spec caught the aria-current Franchises item doing
     exactly this). Gold belongs on navy surfaces only, so the gold
     current/hover treatment stays on top-level labels; open-menu items
     use the cream highlight (same as the current-page menu style)
     which passes on light surfaces. */
  .ukbt-header__nav > ul > li > a[aria-current='page'],
  .ukbt-header__nav > ul > li > div > a[aria-current='page'] {
    color: var(--ukbt-color-brand-accent);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-header__nav > ul > li > a:hover,
  .ukbt-header__nav > ul > li > div > a:hover {
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-header__nav .ukbt-header__dropdown a:hover {
    background: var(--ukbt-color-surface-alt);
  }
  /* Gold underline-reveal motif: the brand accent grows left-to-right
     under top-level labels on hover — interactive, not decorative. */
  .ukbt-header__nav > ul > li > a,
  .ukbt-header__nav > ul > li > div > a {
    position: relative;
  }
  .ukbt-header__nav > ul > li > a::after,
  .ukbt-header__nav > ul > li > div > a::after {
    content: '';
    position: absolute;
    left: 15px;
    right: 15px;
    bottom: -4px;
    height: 2px;
    background: var(--ukbt-color-brand-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ukbt-motion-duration-base)
      var(--ukbt-motion-easing-standard);
  }
  .ukbt-header__nav > ul > li > a:hover::after,
  .ukbt-header__nav > ul > li > div > a:hover::after,
  .ukbt-header__nav > ul > li > a[aria-current='page']::after,
  .ukbt-header__nav > ul > li > div > a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Each dropdown owns its positioning context: the item is a flex row
     (label + chevron side by side, never stacked) and the menu anchors
     to it — never to the nav row, never to the viewport. */
  .ukbt-header__nav-item--has-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }
  /* Dropdown chevron: an exact 24x24 box, never padding-derived.
     axe target-size measured 20x24 here (10px glyph + space-1 padding
     came to 20px wide, and margin-inline-start:-4px pulled the box 4px
     under the label so the remainder read as "partially obscured").
     No negative margin: the label's own inline padding already sets
     the visual rhythm, and encroaching on it stole hit area. */
  .ukbt-header__dropdown-toggle {
    appearance: none;
    border: none;
    background: none;
    color: inherit;
    padding: 0;
    cursor: pointer;
    vertical-align: middle;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
  }
  /* Chevron rotation shared by the desktop dropdown toggle and the
     mobile drawer accordion (identical transition; one rule for both —
     deduped to fund evidence-backed rules within the CSS budget). */
  .ukbt-header__dropdown-toggle svg,
  .ukbt-header__drawer-accordion svg {
    transition: transform var(--ukbt-motion-duration-base)
      var(--ukbt-motion-easing-standard);
  }
  .ukbt-header__dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* Desktop dropdown menu. Width is content-aware (max-content within
     viewport-safe bounds) so the single-child Franchises menu stays
     compact while the three-child Events menu takes only the room it
