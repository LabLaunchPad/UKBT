---
// WhyChooseUs — re-art-directed. Clean vertical reasons, not a four-box grid.
// Editorial composition: statement + reasons as a typographic list.
import SectionHeader from './SectionHeader.astro';

interface Reason {
  title: string;
  body: string;
}
interface Props {
  reasons: Reason[];
  /** editorial: display-scale numerals with a gold tick + larger titles
     (homepage identity narrative). default preserves current rendering. */
  variant?: 'default' | 'editorial';
  /** Intro line. Defaults to the homepage wording; About passes its
     own framing (A2). Items untouched either way. */
  lede?: string;
}
const { reasons, variant = 'default', lede = 'What the club is, stated from what is on record.' } = Astro.props;
---

<div class:list={['ukbt-chooseus', variant === 'editorial' && 'ukbt-chooseus--editorial']}>
  <div class="ukbt-chooseus__header">
    <SectionHeader
      eyebrow="Why the Tigers"
      heading="A Club Built for the International Stage"
      lede={lede}
      rule="none"
    />
  </div>
  <div class="ukbt-chooseus__list">
    {
      reasons.map((r, i) => (
        <div class="ukbt-chooseus__item">
          <span class="ukbt-chooseus__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="ukbt-chooseus__text">
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ukbt-chooseus {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-5);
  }
  .ukbt-chooseus__header {
    max-width: 36rem;
  }
  /* The shared SectionHeader carries trailing for its CTA/rule
     variants (margin 50 + padding 30); this header is rule-none with
     no CTA, so that trailing is pure void above the list. The
     descendant MUST be :global — SectionHeader renders in its own
     Astro scope, so a plain descendant selector silently never
     matches (same scoping rule as homepage.spec.ts's Surface guard).
     The ancestor half keeps this component's scope, so other pages'
     headers are untouched. */
  .ukbt-chooseus__header :global(.ukbt-section-header) {
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .ukbt-chooseus__list {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-5);
  }
  .ukbt-chooseus__item {
    display: flex;
    flex-direction: row;
    gap: var(--ukbt-space-4);
    padding-top: var(--ukbt-space-4);
    border-top: 1px solid var(--ukbt-color-border-subtle);
  }
  .ukbt-chooseus__index {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-3);
    font-weight: var(--ukbt-font-weight-bold);
    line-height: 1;
    color: var(--ukbt-color-brand-primary);
    flex-shrink: 0;
    min-width: 3rem;
  }
  .ukbt-chooseus__text {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
  }
  .ukbt-chooseus__text h3 {
    margin: 0;
    font-size: var(--ukbt-font-size-2);
  }
  .ukbt-chooseus__text p {
    margin: 0;
    font-size: var(--ukbt-font-size-1);
    color: var(--ukbt-color-neutral-700);
    max-width: 48rem;
  }
  /* Editorial variant: numerals at display scale with a decorative gold
     tick (non-text, so the gold-contrast rule is untouched), titles one
     step larger. Numeral colour stays navy — gold text fails on light. */
  .ukbt-chooseus--editorial .ukbt-chooseus__index {
    font-size: var(--ukbt-font-size-5);
    min-width: 4.5rem;
    border-left: 3px solid var(--ukbt-color-brand-accent);
    padding-left: var(--ukbt-space-3);
  }
  .ukbt-chooseus--editorial .ukbt-chooseus__text h3 {
    font-size: var(--ukbt-font-size-3);
  }

  @media screen and (max-width: 767px) {
    .ukbt-chooseus__item {
      flex-direction: column;
      gap: var(--ukbt-space-2);
    }
    .ukbt-chooseus__list {
      gap: var(--ukbt-space-gap-3);
    }
  }
</style>
