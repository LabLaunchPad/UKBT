---
// Players Profile page. The roster combines the 42-name evidence roster
// (EV-20260831-005) with the owner-supplied 2026-09-12 photo drop:
// 59 portraits + the Players & Managements List PDF (EV-20260912-001).
// 58 players (4 renamed per owner direction, 16 new from filenames) +
// 4 team officials, pictured with uniform 320px thumbnails; 8 names
// without photos stay text-only. Individual full profiles (bio, stats)
// beyond the Club Captain remain UNKNOWN and are stated as such rather
// than invented; per CLIENT_REQ_006 the roster renders name + country
// (+ photo where supplied) and no stats table.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import CaptainSpotlight from '../components/CaptainSpotlight.astro';
import SquadGrid from '../components/SquadGrid.astro';
import SquadHead from '../components/SquadHead.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { captain, captainPhoto } from '../content/captain-data';
import { fullRoster, teamOfficials } from '../content/players-data';
// Players banner backdrop (owner direction 2026-09-11): gallery-08,
// owner-confirmed UKBT squad photo (no prior EV finding for this file
// — new owner-supplied drop, see MANIFEST). 1400x783, 291KB.
// Photo is presentation wiring, not a gated fact.
const bannerBackground = {
  src: '/media/gallery-08.jpg',
  alt: 'UK Bangla Tigers squad posing for a team photo',
  width: 1400,
  height: 783,
};
---

<BaseLayout
  title="Players Profile â€” UK Bangla Tigers"
  description="UK Bangla Tigers player profiles."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner
      title="Players Profile"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Players Profile' }]}
      background={bannerBackground}
    />

    <Section>
      <div class="ukbt-players-stat">
        <span class="ukbt-players-stat__value">{homepage.stats.players}</span>
        <span class="ukbt-players-stat__label">Players across the squad</span>
      </div>
      <CaptainSpotlight name={captain.name} role={captain.role} photo={captainPhoto} />
    </Section>

    <Section surface="alt">
      <SquadHead
        eyebrow="Our Team"
        heading="Squad"
        count={`${fullRoster.length} Players · ${teamOfficials.length} Officials`}
      />
      <SquadGrid players={fullRoster} id="squad" />
    </Section>

    <Section>
      <SquadHead eyebrow="Backroom" heading="Team Officials" sub />
      <SquadGrid
        players={teamOfficials}
        variant="official"
        filters={false}
        unit="Officials"
      />
    </Section>

    <Section paddingBottom="normal">
      <p class="ukbt-players-note">
        Full individual profiles (biography, career statistics, photo) for
        the rest of the squad are being confirmed with the club and will be
        published here as they're ready. The Club Captain's full profile is
        available now.
      </p>
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  .ukbt-players-stat {
    display: flex;
    align-items: baseline;
    gap: var(--ukbt-space-3);
    margin-bottom: var(--ukbt-space-8);
  }
  .ukbt-players-stat__value {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-5);
    font-weight: var(--ukbt-font-weight-bold);
    color: var(--ukbt-color-brand-primary);
  }
  .ukbt-players-stat__label {
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-players-note {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    max-width: 42rem;
  }
</style>
