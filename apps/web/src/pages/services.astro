---
// Mirrors the reference's `service.html` (Banner â†’ Service â†’ Membership
// CTA â†’ Pricing â†’ Testimonial â†’ Contact CTA). Route added under
// CLIENT_REQ_009 / ROUTE-CONTRACT Amendment 01.
//
// SHELL. `noindex` per that amendment's condition 2. The reference page
// sells court hire, coaching packages and pricing tiers. UKBT has no
// evidence of offering any service to the public â€” the club's evidenced
// activity is competing in tournaments â€” so every content slot here is
// UNKNOWN. Indexing this page would be a public claim that the club
// sells something, which is exactly what condition 2 guards against.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PendingContent from '../components/PendingContent.astro';
import AboutCTA from '../components/AboutCTA.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
---

<BaseLayout title="What We Do â€” UK Bangla Tigers" description="What UK Bangla Tigers offers."
  noindex={true}>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />
  <main id="main-content" tabindex="-1">
    <PageBanner title="What We Do" crumbs={[{ label: 'Home', href: '/' }, { label: 'What We Do' }]} />

    <Section>
      <SectionHeader eyebrow="What We Do" heading="Club Programmes" />
      <PendingContent
        what="Club programmes are not defined yet."
        detail="The club's evidenced activity is international tournament cricket. Any programme offered to the public will be described here once confirmed."
        minHeight="12rem"
      />
    </Section>

    <Section surface="alt">
      <SectionHeader eyebrow="Pricing" heading="Fees & Membership Tiers" />
      <PendingContent
        what="No fees or membership tiers are published."
        detail="Nothing in the club material supplied so far sets out a price, a tier, or a joining fee. None is invented here."
        minHeight="12rem"
      />
    </Section>

    <Section surface="alt" paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>
  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>
