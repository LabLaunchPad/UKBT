---
// Uppsala Tigers franchise detail page — moved here from the single-page
// /franchises showcase (which is now the Our Franchises card-grid
// landing) per the client's instruction that this franchise sit under a
// clickable "Our Franchise" list (EV-20260831-001, EV-20260831-002;
// contracts/ROUTE-CONTRACT.md AMENDMENT 02). Full squad + team officials
// per the club's own "Uppsala Tigers Players & Managements List"
// (EV-20260831-005/-006), superseding the earlier overseas-only roster.
// "Nipo Khadem" excluded per CLIENT_REQ_008 — absent from every squad
// list supplied since that instruction.
//
// The intro image is Uppsala Tigers' own supplied crest
// (EV-20260831-004), not nordic-smash-slide.webp: that graphic has "NIPO
// KHADEM / PORTUGAL" baked into the photo itself (EV-20260826-031, found
// on direct visual inspection of this page's own screenshot) — no
// text-content check can catch a name inside a raster image. No
// alternative photo excluding that player exists in evidence.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageBanner from '../../components/PageBanner.astro';
import Section from '../../components/Section.astro';
import SquadGrid from '../../components/SquadGrid.astro';
import SquadHead from '../../components/SquadHead.astro';
import Footer from '../../components/Footer.astro';
import { homepage } from '../../content/homepage-data';
import {
  ourFranchises,
  uppsalaFacts,
  uppsalaOfficials,
  uppsalaSquad,
} from '../../content/franchises-data';
import SubHeading from '../../components/SubHeading.astro';

const uppsala = ourFranchises.find((f) => f.slug === 'uppsala-tigers');
if (!uppsala) {
  throw new Error("franchises-data.ts's ourFranchises is missing 'uppsala-tigers'");
}
---

<BaseLayout
  title="Uppsala Tigers — Our Franchises — UK Bangla Tigers"
  description="UK Bangla Tigers' sister franchise, Uppsala Tigers (Sweden)."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner
      title="Uppsala Tigers"
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Our Franchises', href: '/franchises/' },
        { label: 'Uppsala Tigers' },
      ]}
    />

    <Section>
      <div class="ukbt-franchise-intro">
        <div class="ukbt-franchise-intro__crest-panel">
          {/* Pair to the franchise card crest on /franchises (same file,
             same 220x220): list → detail continuity. */}
          <img
            src={uppsala.logo}
            width="220"
            height="220"
            alt={uppsala.logoAlt}
            transition:name="ukbt-franchise-crest"
          />
        </div>
        {/*
          Owner directive 2026-09-26/27: the Nordic Smash T20 title (h3) stays
          out of the intro, but the owner-supplied fact BODY is restored here
          as the subheader lede — rendered from the uppsalaFacts data export
          (single source of truth for copy, EV-20260926-001), not pasted.
        */}
        <div class="ukbt-franchise-intro__text">
          <SubHeading label="Sister Franchise" />
          <h2 class="ukbt-franchise-intro__title">Uppsala Tigers is a franchise team owned and managed by UK Bangla Tigers</h2>
          {
            uppsalaFacts.map((f) => (
              <p class="ukbt-franchise-intro__lede">{f.body}</p>
            ))
          }
          <a class="ukbt-franchise-intro__squad-link" href="#squad">
            Meet the squad <span aria-hidden="true">&darr;</span>
          </a>
        </div>
      </div>
    </Section>

    <Section surface="alt">
      <SquadHead
        eyebrow="Uppsala Tigers"
        heading="Squad"
        count={`${uppsalaSquad.length} Players · ${uppsalaOfficials.length} Officials`}
      />
      <SquadGrid
        players={uppsalaSquad}
        id="squad"
        filterLabel="Filter Uppsala Tigers squad"
        unit="Players"
        org="Uppsala Tigers"
      />
    </Section>

    <Section paddingBottom="normal">
      <SquadHead heading="Team Officials" sub />
      <SquadGrid
        players={uppsalaOfficials}
        variant="official"
        filters={false}
        id="team-officials"
        unit="Officials"
        org="Uppsala Tigers"
      />
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  /*
   * Intro type truth: semantic h2, visual scale from the H3 TOKEN set
   * (36/28/22px + responsive steps) in brand-navy — the 64px H2 hero scale
   * drowned the crest-adjacent headline. One source: design tokens only.
   */
  .ukbt-franchise-intro {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--ukbt-space-gap-5);
    align-items: center;
  }
  .ukbt-franchise-intro__text {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-2);
  }
  .ukbt-franchise-intro__title {
    margin: 0;
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-heading-h3-size);
    font-weight: var(--ukbt-font-heading-h3-weight);
    line-height: var(--ukbt-font-heading-h3-line-height);
    color: var(--ukbt-color-brand-primary);
  }
  /*
   * Lede truth: same body-copy tokens as the franchises index intro line
   * (size-1 on neutral-700, 40rem measure) — one source, reused.
   */
  .ukbt-franchise-intro__lede {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-1);
    max-width: 40rem;
  }
  .ukbt-franchise-intro__squad-link {
    display: inline-block;
    margin-top: var(--ukbt-space-1);
    color: var(--ukbt-color-brand-primary);
    font-size: var(--ukbt-font-size-0);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-franchise-intro__squad-link:hover {
    text-decoration: underline;
  }
  .ukbt-franchise-intro__crest-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-lg);
    padding: var(--ukbt-space-8) var(--ukbt-space-4);
  }
  .ukbt-franchise-intro__crest-panel img {
    display: block;
    height: 14rem;
    width: auto;
    max-width: 100%;
  }

  /* Reference `.community-grid` collapses to a single column at <=1025px. */
  @media screen and (max-width: 1025px) {
    .ukbt-franchise-intro {
      grid-template-columns: 1fr;
      gap: var(--ukbt-space-gap-5);
    }
    .ukbt-franchise-intro__title {
      font-size: var(--ukbt-font-heading-h3-size-md);
    }
    .ukbt-franchise-intro__crest-panel img {
      height: 10rem;
    }
  }
  @media screen and (max-width: 767px) {
    .ukbt-franchise-intro__title {
      font-size: var(--ukbt-font-heading-h3-size-sm);
    }
    .ukbt-franchise-intro__crest-panel img {
      height: 8rem;
    }
  }
</style>
