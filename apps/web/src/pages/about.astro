---
// About Us page — implements artifacts/pages/ABOUT-CONTRACT.md. Content
// bound to @ukbt/truth's gate (src/content/about-data.ts); shared nav/
// social come from homepage-data.ts so they are gated exactly once.
// Each section's geometry mirrors the reference's actual measured layout
// (checked directly against the Adelux `about.html`/`main.css` source —
// see per-component comments), reimplemented with UKBT content/branding.
// No Adelux code, content, or branding appears anywhere below.
//
// Sponsors section (EV-20260831-007) reinstates the reference's
// partner-logo panel (`.partnership-container`) right where
// MissionWelcome.astro's own header comment noted its omission "no
// sponsor is evidenced" — now one is.
//
// Tina visual editing: heroSubline, storyBody, leadershipIntro
// sourced from @tinacms/astro getAbout(); truth-gated data
// (founded, stats, leaders, founder, missionFacts, storyParagraphs)
// still from @ukbt/truth via about-data.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import MissionWelcome from '../components/MissionWelcome.astro';
import Sponsors from '../components/Sponsors.astro';
import AboutStory from '../components/AboutStory.astro';
import FounderSpotlight from '../components/FounderSpotlight.astro';
import LeadershipGrid from '../components/LeadershipGrid.astro';
import AboutCTA from '../components/AboutCTA.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { tinaField } from '@tinacms/astro';
import { type TinaRichTextContent } from '@tinacms/astro';
import { getAbout } from '../lib/tina/data';
import { homepage } from '../content/homepage-data';
import { about } from '../content/about-data';
import { ourSponsors } from '../content/sponsors-data';
import { aboutGraph } from '../lib/seo';

const aboutRes = await getAbout();
const tinaAbout = (aboutRes?.data as { about?: Record<string, unknown> })?.about || {};

const storyStats = [
  { value: about.founded, label: 'Founded' },
  { value: about.stats.players, label: 'Players' },
  { value: about.stats.tournaments, label: 'International Tournaments' },
];

const founderStats: { value: string; label: string; icon: 'trophy' | 'people' }[] = [
  { value: about.founder.stats.careerMatches, label: 'Career Matches', icon: 'trophy' },
  { value: about.founder.stats.activePlayers, label: 'Active Players', icon: 'people' },
];

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About Us' }];
const bannerBackground = {
  src: '/media/gallery-06.webp',
  alt: 'UK Bangla Tigers squad celebrating with a trophy',
  width: 1400,
  height: 933,
};
const structuredData = aboutGraph({
  description: about.tagline,
  crumbs,
});
---

<BaseLayout
  title="About Us — UK Bangla Tigers"
  description={about.tagline}
  structuredData={structuredData}
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <TinaIsland name="aboutSection" wrapper={{ tag: 'div', className: '' }}>
      <PageBanner
        title="About Us"
        crumbs={crumbs}
        lede={tinaAbout.heroSubline as string || about.heroSubline}
        background={bannerBackground}
        data-tina-field={tinaField(tinaAbout, 'heroSubline')}
      />
    </TinaIsland>

    <Section density="compact">
      <MissionWelcome tagline={about.tagline} facts={about.missionFacts} />
    </Section>

    <Section surface="alt" wrapper={true} density="compact">
      <Sponsors sponsors={ourSponsors} />
    </Section>

    <Section density="compact">
      <TinaIsland name="aboutStory" wrapper={{ tag: 'div', className: '' }}>
        <AboutStory
          paragraphs={about.storyParagraphs}
          stats={storyStats}
          data-tina-field={tinaField(tinaAbout, 'storyBody')}
          content={tinaAbout.storyBody as TinaRichTextContent}
        />
      </TinaIsland>
    </Section>

    <Section density="compact">
      <FounderSpotlight
        image={about.founder.image}
        cardTitle="Founder of UK Bangla Tigers, competing at the Safari International T20 Cup."
        eyebrow="Founder Spotlight"
        heading="Mohammad Chowdhury, Founder and CEO."
        paragraphs={about.founder.story}
        stats={founderStats}
        composition="mirror"
      />
    </Section>

    {/*
      WhyChooseUs removed (owner direction 2026-09-11): its 01-04 list
      restated MissionWelcome's four fact cards byte-for-byte in two
      slots, and carried the stale tournament list (Nordic Smash / Asian
      Challengers as current). Mission cards own the pillar statement;
      the Mission list (Nordic Lights + Global T20 upcoming) is the
      current publishable record. Component untouched — still serves
      the homepage via its default variant.
    */}

    <Section density="compact">
      <TinaIsland name="aboutLeadership" wrapper={{ tag: 'div', className: '' }}>
        <LeadershipGrid
          leaders={about.leaders}
          intro={tinaAbout.leadershipIntro as string || about.leadershipIntro}
          data-tina-field={tinaField(tinaAbout, 'leadershipIntro')}
        />
      </TinaIsland>
    </Section>

    <!-- TestimonialSection omitted: no real testimonials exist yet -->

    <Section surface="alt" paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>
