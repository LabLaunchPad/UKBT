---
// Our Franchises landing — a card grid, one entry per sister franchise,
// each linking to its own detail page under /franchises/. Restructured
// from a single-franchise showcase per the client's instruction that
// Uppsala Tigers sit under a clickable "Our Franchise" list, built so
// future franchises can be added the same way (EV-20260831-001,
// EV-20260831-002) — route addition authorised by
// contracts/ROUTE-CONTRACT.md AMENDMENT 02. Only Uppsala Tigers exists
// today; no future franchise is invented to fill out the grid.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { ourFranchises } from '../content/franchises-data';
// Franchises banner backdrop (owner direction 2026-09-11):
// nordic-smash-slide.jpg, Uppsala Tigers overseas-signings graphic
// for the Nordic Smash T20. CLIENT_REQ_008 WAIVED for this use only
// (owner chat 2026-09-11 — the graphic bakes in an excluded name;
// see MANIFEST). Alt text carries NO names: the contamination gates
// scan rendered HTML, and baked-in pixel text must not enter the DOM.
// 1600x649, 202KB. Photo is presentation wiring, not a gated fact.
const bannerBackground = {
  src: '/media/nordic-smash-slide.jpg',
  alt: 'Uppsala Tigers overseas signings graphic for the Nordic Smash T20',
  width: 1600,
  height: 649,
};
---

<BaseLayout
  title="Our Franchises — UK Bangla Tigers"
  description="UK Bangla Tigers' sister franchises, competing internationally."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner
      title="Our Franchises"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Our Franchises' }]}
      background={bannerBackground}
    />

    <Section paddingBottom="normal">
      {/*
        Multi-agent UI/UX audit 2026-09-26: with a single verified franchise
        the N-item grid rendered a 16rem sliver + void. The :only-child
        override promotes the singleton to a full-width feature card and
        reverts automatically when a second franchise lands. Blurb stays
        verbatim (gate-backed copy); "more to come" framing rests on the
        client instruction cited in franchises-data.ts (EV-0831-01/02).
      */}
      <p class="ukbt-franchise-intro">
        Our sister franchise. More franchises will be added here as they launch.
      </p>
      <ul class="ukbt-franchise-grid">
        {
          ourFranchises.map((f) => (
            <li>
              <article class="ukbt-franchise-card">
                <a class="ukbt-franchise-card__link" href={`/franchises/${f.slug}/`}>
                  <div class="ukbt-franchise-card__crest-panel">
                    {/*
                      Shared-element crest: same file, same 220x220 geometry as
                      the Uppsala detail intro, so card → detail morphs one
                      genuine object. Uppsala is currently the sole franchise
                      with a detail page — a second one must use its own name,
                      since a duplicated name silently disables the pair.
                      alt="" here: the adjacent h2 names the franchise, so the
                      crest is decorative in this card context (logoAlt stays
                      in the data module for the detail-page use).
                    */}
                    <img
                      src={f.logo}
                      width="220"
                      height="220"
                      alt=""
                      transition:name="ukbt-franchise-crest"
                    />
                  </div>
                  <div class="ukbt-franchise-card__body">
                    <h2 class="ukbt-franchise-card__title">{f.name}</h2>
                    <p class="ukbt-franchise-card__country">{f.country}</p>
                    <p class="ukbt-franchise-card__blurb">{f.blurb}</p>
                    <span class="ukbt-franchise-card__cta">
                      View team &amp; squad <span aria-hidden="true">&rarr;</span>
                    </span>
                  </div>
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  .ukbt-franchise-intro {
    margin: 0 0 var(--ukbt-space-6) 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-1);
    max-width: 40rem;
  }
  .ukbt-franchise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--ukbt-space-8);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: start;
  }
  /* Singleton: full-width horizontal feature card. Auto-reverts to the
     N-item grid above when a second franchise lands. */
  .ukbt-franchise-grid:has(> :only-child) {
    grid-template-columns: 1fr;
  }
  .ukbt-franchise-grid:has(> :only-child) .ukbt-franchise-card__link {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--ukbt-space-6);
  }
  .ukbt-franchise-card {
    margin: 0;
  }
  .ukbt-franchise-card__link {
    display: block;
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-lg);
    border-top: 3px solid var(--ukbt-color-brand-accent);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--ukbt-motion-duration-base) var(--ukbt-motion-easing-standard),
      box-shadow var(--ukbt-motion-duration-base) var(--ukbt-motion-easing-standard);
  }
  .ukbt-franchise-card__link:hover {
    transform: translateY(-4px);
    box-shadow: var(--ukbt-shadow-md);
  }
  .ukbt-franchise-card__link:hover .ukbt-franchise-card__cta {
    text-decoration: underline;
  }
  .ukbt-franchise-card__crest-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ukbt-color-surface-alt);
    padding: var(--ukbt-space-6) var(--ukbt-space-4);
  }
  .ukbt-franchise-card__crest-panel img {
    display: block;
    height: 8rem;
    width: auto;
  }
  .ukbt-franchise-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
    padding: var(--ukbt-space-4) var(--ukbt-space-6) var(--ukbt-space-6);
  }
  .ukbt-franchise-card__body p {
    max-width: 40rem;
  }
  .ukbt-franchise-card__title {
    margin: 0;
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-2);
    font-weight: var(--ukbt-font-weight-bold);
    line-height: 1.3;
    color: var(--ukbt-color-brand-primary);
  }
  .ukbt-franchise-card__country {
    margin: 0 0 var(--ukbt-space-1) 0;
    color: var(--ukbt-color-brand-primary);
    font-size: var(--ukbt-font-size-0);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-franchise-card__blurb {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
  .ukbt-franchise-card__cta {
    display: inline-block;
    margin-top: var(--ukbt-space-2);
    color: var(--ukbt-color-brand-primary);
    font-size: var(--ukbt-font-size-0);
    font-weight: var(--ukbt-font-weight-bold);
  }
  @media (max-width: 1025px) {
    .ukbt-franchise-grid:has(> :only-child) .ukbt-franchise-card__link {
      gap: var(--ukbt-space-4);
    }
    .ukbt-franchise-card__crest-panel img {
      height: 6rem;
    }
  }
  @media (max-width: 767px) {
    .ukbt-franchise-grid:has(> :only-child) .ukbt-franchise-card__link {
      grid-template-columns: 1fr;
      gap: var(--ukbt-space-4);
    }
    .ukbt-franchise-card__crest-panel img {
      height: 5.5rem;
    }
    .ukbt-franchise-card__body {
      padding: var(--ukbt-space-6);
    }
  }
</style>
