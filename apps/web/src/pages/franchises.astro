---
// Our Franchises landing â€” a card grid, one entry per sister franchise,
// each linking to its own detail page under /franchises/. Restructured
// from a single-franchise showcase per the client's instruction that
// Uppsala Tigers sit under a clickable "Our Franchise" list, built so
// future franchises can be added the same way (EV-20260831-001,
// EV-20260831-002) â€” route addition authorised by
// contracts/ROUTE-CONTRACT.md AMENDMENT 02. Only Uppsala Tigers exists
// today; no future franchise is invented to fill out the grid.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { ourFranchises } from '../content/franchises-data';
// Franchises banner backdrop (owner direction 2026-09-11):
// nordic-smash-slide.jpg, Uppsala Tigers overseas-signings graphic
// for the Nordic Smash T20. CLIENT_REQ_008 WAIVED for this use only
// (owner chat 2026-09-11 — the graphic bakes in an excluded name;
// see MANIFEST). Alt text carries NO names: the contamination gates
// scan rendered HTML, and baked-in pixel text must not enter the DOM.
// 1600x649, 202KB. Photo is presentation wiring, not a gated fact.
const bannerBackground = {
  src: '/media/nordic-smash-slide.jpg',
  alt: 'Uppsala Tigers overseas signings graphic for the Nordic Smash T20',
  width: 1600,
  height: 649,
};
---

<BaseLayout
  title="Our Franchises â€” UK Bangla Tigers"
  description="UK Bangla Tigers' sister franchises, competing internationally."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner
      title="Our Franchises"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Our Franchises' }]}
      background={bannerBackground}
    />

    <Section paddingBottom="normal">
      <div class="ukbt-franchise-grid">
        {
          ourFranchises.map((f) => (
            <h2>
              <a class="ukbt-franchise-card" href={`/franchises/${f.slug}/`}>
                <div class="ukbt-franchise-card__crest-panel">
                  {/*
                    Shared-element crest: same file, same 220x220 geometry as
                    the Uppsala detail intro, so card → detail morphs one
                    genuine object. Uppsala is currently the sole franchise
                    with a detail page — a second one must use its own name,
                    since a duplicated name silently disables the pair.
                  */}
                  <img
                    src={f.logo}
                    width="220"
                    height="220"
                    alt={f.logoAlt}
                    transition:name="ukbt-franchise-crest"
                  />
                </div>
                <div class="ukbt-franchise-card__body">
                  <span>{f.name}</span>
                  <p class="ukbt-franchise-card__country">{f.country}</p>
                  <p>{f.blurb}</p>
                </div>
              </a>
            </h2>
          ))
        }
      </div>
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  .ukbt-franchise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--ukbt-space-8);
  }
  .ukbt-franchise-card {
    display: block;
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-lg);
    border-top: 3px solid var(--ukbt-color-brand-accent);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }
  .ukbt-franchise-card__crest-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ukbt-color-surface);
    padding: var(--ukbt-space-8) var(--ukbt-space-4);
  }
  .ukbt-franchise-card__crest-panel img {
    display: block;
    height: 8rem;
    width: auto;
  }
  .ukbt-franchise-card__body {
    padding: var(--ukbt-space-4);
  }
  .ukbt-franchise-card__body span {
    margin: 0 0 var(--ukbt-space-1) 0;
    font-size: var(--ukbt-font-size-2);
  }
  .ukbt-franchise-card__country {
    margin: 0 0 var(--ukbt-space-2) 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
  .ukbt-franchise-card__body p:last-child {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
</style>
