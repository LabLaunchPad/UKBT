---
// Player application. Route added under CLIENT_REQ_009 / ROUTE-CONTRACT
// Amendment 01, which mirrors the reference's `booking.html` (Banner →
// booking process → booking → contact CTA). UKBT has no booking product;
// the nearest real concept is applying to play, so that is what the route
// is framed as. `noindex` per that amendment's condition 2 — unchanged by
// the form landing, since an indexed page would be a public claim the club
// is taking applications.
//
// The form UI ships ahead of the submission endpoint, by owner decision
// 2026-09-26 (docs/superpowers/specs/2026-09-26-join-form-design.md).
// FORM-CONTRACT (FROZEN) puts all delivery behind `submitForm(payload)`,
// whose v1 adapter answers `unavailable` and discards the payload — so the
// UI is real and reviewable today while nothing can be truthfully reported
// as delivered. The honesty rule follows from that: JoinForm has no
// success state anywhere, and a visible pre-submit notice says online
// applications are not open before anyone clicks Send.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import JoinForm from '../components/JoinForm.astro';
import AboutCTA from '../components/AboutCTA.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
---

<BaseLayout title="Join the Club — UK Bangla Tigers" description="Apply to play for UK Bangla Tigers."
  noindex={true}>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />
  <main id="main-content" tabindex="-1">
    <PageBanner title="Join the Club" crumbs={[{ label: 'Home', href: '/' }, { label: 'Join the Club' }]} />

    <Section>
      <SectionHeader eyebrow="Joining" heading="How to Join" />
      <JoinForm />
    </Section>

    <Section surface="alt" paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>
  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>
