---
// Coaching / Academy page â€” mirrors the reference's `coaching.html`
// sequence (Banner â†’ Team Page â†’ Contact CTA â†’ Testimonial).
// Route added under CLIENT_REQ_009 / ROUTE-CONTRACT Amendment 01.
//
// This is the reference page with the strongest UKBT counterpart: the
// club's own twice-corroborated tagline is "not only a team, but also an
// institute for learning" (EV-20260826-028, EV-20260826-029).
//
// The reference fills its Team Page section with named coaches and their
// photographs. UKBT has no coaching staff on record at all â€” the only
// evidenced individuals are the three leadership figures and the Club
// Captain â€” so that section is a shell rather than a cast of invented
// coaches.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AcademySection from '../components/AcademySection.astro';
import PendingContent from '../components/PendingContent.astro';
import AboutCTA from '../components/AboutCTA.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';

const academyCounters = [
  { value: homepage.stats.players, label: 'Players across the squad' },
  { value: homepage.stats.countries, label: 'Countries internationals' },
  { value: homepage.stats.tournaments, label: 'International tournaments' },
];
---

<BaseLayout
  title="Coaching & Development â€” UK Bangla Tigers"
  description="Coaching and Development at UK Bangla Tigers: academy programme, coaching team announcements and the club's institute for learning."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />
  <main id="main-content" tabindex="-1">
    <PageBanner
      title="Coaching & Development"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Coaching & Development' }]}
    />

    <Section surface="inverse" wrapper={true}>
      <AcademySection tagline={homepage.tagline} counters={academyCounters} />
    </Section>

    <Section>
      <SectionHeader eyebrow="Our Coaching" heading="Meet the Coaching Team" />
      <PendingContent
        what="Coaching staff are not yet confirmed."
        detail="No coach is named in the club material supplied so far. Profiles will be published here once the club confirms them."
        minHeight="12rem"
      />
    </Section>

    <!-- TestimonialSection omitted: no real testimonials exist yet -->

    <Section paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>
  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>
