---
// Mirrors the reference's `faq.html` (Banner → FAQ → Membership CTA →
// Blog). Route added under CLIENT_REQ_009 / ROUTE-CONTRACT Amendment 01.
//
// FAQ content sourced from Tina CMS via getFaq().
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AboutCTA from '../components/AboutCTA.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import FAQSection from '../components/FAQSection.astro';
import { tinaField } from '@tinacms/astro';
import { getFaq } from '../lib/tina/data';
import { homepage } from '../content/homepage-data';
import { type TinaRichTextContent } from '@tinacms/astro';

const faqRes = await getFaq();
const tinaFaq = (faqRes?.data as { faq?: Record<string, unknown> })?.faq || {};
const visibleItems = ((tinaFaq.items || []) as Array<{ question: string; answer: TinaRichTextContent; visible?: boolean; _content_source?: unknown }>).filter((item) => item.visible !== false);
---

<BaseLayout title={`${tinaFaq.pageHeading} — UK Bangla Tigers`} description="Answers to common questions about UK Bangla Tigers.">
  <Header nav={homepage.nav} cta={homepage.primaryCta} />
  <main id="main-content" tabindex="-1">
    <PageBanner title="Frequently Asked Questions" crumbs={[{ label: 'Home', href: '/' }, { label: 'FAQ' }]} />

    <Section>
      <SectionHeader eyebrow={(tinaFaq.pageEyebrow as string) || 'FAQ'} heading={tinaFaq.pageHeading as string} eyebrowTinaField={tinaField(tinaFaq, "pageEyebrow")} headingTinaField={tinaField(tinaFaq, "pageHeading")} />
      {/*
        Page and island share one component (FAQSection): identical markup,
        styles, and per-item tinaField(item, …) markers on both sides of the
        bridge. No duplicated list markup or <style> in this page.
      */}
      <TinaIsland name="faq" wrapper={{ tag: 'div', className: '' }}>
        <FAQSection items={visibleItems} />
      </TinaIsland>
    </Section>

    <Section surface="alt" paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>
  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>
