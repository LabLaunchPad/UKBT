---
// Mirrors the reference's `faq.html` (Banner → FAQ → Membership CTA →
// Blog). Route added under CLIENT_REQ_009 / ROUTE-CONTRACT Amendment 01.
//
// FAQ content sourced from Tina CMS via faq.json. The visible flag
// allows the client to hide questions without deleting them.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AboutCTA from '../components/AboutCTA.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { tinaFaq } from '../lib/tina/loaders';
import { renderFaqAnswer } from '../lib/faq-answer';

const visibleItems = tinaFaq.items.filter((item) => item.visible !== false);
---

<BaseLayout title={`${tinaFaq.pageHeading} — UK Bangla Tigers`} description="Answers to common questions about UK Bangla Tigers.">
  <Header nav={homepage.nav} cta={homepage.primaryCta} />
  <main id="main-content" tabindex="-1">
    <PageBanner title="Frequently Asked Questions" crumbs={[{ label: 'Home', href: '/' }, { label: 'FAQ' }]} />

    <Section>
      <SectionHeader eyebrow={tinaFaq.pageEyebrow || 'FAQ'} heading={tinaFaq.pageHeading} />
      {visibleItems.length > 0 ? (
        <div class="ukbt-faq-list">
              {visibleItems.map((item) => (
            <details class="ukbt-faq-item">
              <summary class="ukbt-faq-question" data-tina-field="items.question">{item.question}</summary>
              {/* REM-001: set:html is safe ONLY because renderFaqAnswer escapes
                  all CMS text first — see apps/web/src/lib/faq-answer.ts. */}
              <div class="ukbt-faq-answer" set:html={renderFaqAnswer(item.answer)} />
            </details>
          ))}
        </div>
      ) : (
        <p class="ukbt-faq-empty">No questions are answered yet. Answers will be published here as the club confirms them.</p>
      )}
    </Section>

    <Section surface="alt" paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>
  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  .ukbt-faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-4);
    max-width: 48rem;
  }
  .ukbt-faq-item {
    border-bottom: 1px solid var(--ukbt-color-neutral-200);
    padding-bottom: var(--ukbt-space-4);
  }
  .ukbt-faq-item[open] {
    padding-bottom: var(--ukbt-space-2);
  }
  .ukbt-faq-question {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-2);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--ukbt-space-2);
    min-height: 44px;
  }
  .ukbt-faq-question::before {
    content: '+';
    font-size: 1.25em;
    font-weight: 700;
    color: var(--ukbt-color-brand-accent);
    flex-shrink: 0;
  }
  .ukbt-faq-item[open] .ukbt-faq-question::before {
    content: '−';
  }
  .ukbt-faq-question::-webkit-details-marker {
    display: none;
  }
  .ukbt-faq-question:focus-visible {
    outline: 2px solid var(--ukbt-color-brand-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .ukbt-faq-answer {
    padding: var(--ukbt-space-3) 0 var(--ukbt-space-2) 0;
    color: var(--ukbt-color-neutral-700);
    line-height: 1.6;
  }
  .ukbt-faq-answer :global(p) {
    margin: 0 0 var(--ukbt-space-3) 0;
  }
  .ukbt-faq-answer :global(p:last-child) {
    margin-bottom: 0;
  }
  .ukbt-faq-empty {
    color: var(--ukbt-color-neutral-500);
    font-style: italic;
    max-width: 48rem;
  }
</style>
