---
// Mirrors the reference's `faq.html` (Banner → FAQ → Membership CTA →
// Blog). Route added under CLIENT_REQ_009 / ROUTE-CONTRACT Amendment 01.
//
// FAQ content sourced from Tina CMS via getFaq().
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import AboutCTA from '../components/AboutCTA.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import FAQSection from '../components/FAQSection.astro';
import { getFaq } from '../lib/tina/data';
import { tinaFaq as tinaFaqLocal } from '../lib/tina/loaders';
import { homepage } from '../content/homepage-data';
import { type TinaRichTextContent } from '@tinacms/astro';

const faqRes = await getFaq();
const tinaFaqRemote = (faqRes?.data as { faq?: Record<string, unknown> })?.faq || {};
// TinaCloud is the authority when it returns content; local JSON is the
// fallback for first-build/unauthenticated/empty-index cases (prevents an
// empty FAQ page and keeps e2e deterministic).
const tinaFaq = (tinaFaqRemote.items as unknown[])?.length
  ? tinaFaqRemote
  : (tinaFaqLocal as unknown as Record<string, unknown>);
const visibleItems = ((tinaFaq.items || []) as Array<{ question: string; answer: TinaRichTextContent; visible?: boolean; _content_source?: unknown }>).filter((item) => item.visible !== false);
---

<BaseLayout title={`${tinaFaq.pageHeading} — UK Bangla Tigers`} description="Answers to common questions about UK Bangla Tigers.">
  <Header nav={homepage.nav} cta={homepage.primaryCta} />
  <main id="main-content" tabindex="-1">
    <PageBanner title="Frequently Asked Questions" crumbs={[{ label: 'Home', href: '/' }, { label: 'FAQ' }]} />

    <Section>
      {/*
        Header lives inside the faq island: heading/eyebrow edits live-update
        on bridge re-render instead of going stale outside the boundary.
      */}
      <TinaIsland name="faq" wrapper={{ tag: 'div', className: '' }}>
        <FAQSection
          items={visibleItems}
          pageHeading={tinaFaq.pageHeading as string}
          pageEyebrow={(tinaFaq.pageEyebrow as string) || 'FAQ'}
          data={tinaFaq}
        />
      </TinaIsland>
    </Section>

    <Section surface="alt" paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>
  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>
