---
// Astro's file-based routing serves this for any unmatched path
// automatically. No UKBT organizational fact is needed here.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
---

<BaseLayout noindex noCanonical title="Page Not Found â€” UK Bangla Tigers">
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <Section paddingBottom="normal">
      <div class="ukbt-404">
        <p class="ukbt-404__code">404</p>
        <h1>This page has been bowled out.</h1>
        <p>The page you're looking for doesn't exist or has moved.</p>
        <Button label="Back to Home" href="/" variant="primary" />
      </div>
    </Section>

    <Section paddingTop="none">
      <div class="ukbt-404__links">
        <h2>Popular Pages</h2>
        <ul>
          {
            homepage.nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  .ukbt-404 {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--ukbt-space-3);
    padding-block: var(--ukbt-space-8);
  }
  .ukbt-404__code {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-5);
    font-weight: var(--ukbt-font-weight-bold);
    color: var(--ukbt-color-brand-accent);
    margin: 0;
  }
  .ukbt-404 h1 {
    margin: 0;
  }
  .ukbt-404 p {
    color: var(--ukbt-color-neutral-700);
    margin: 0 0 var(--ukbt-space-3) 0;
  }
  /* Added so the page has a genuine h2 before Footer's h3 column
     headings (found by a mobile axe-core sweep: this was the only route
     with an h1-straight-to-h3 skip, since it's the only page with no
     content section of its own between the hero and the footer). Real
     links from the site's own nav data, not invented copy. */
  .ukbt-404__links {
    text-align: center;
  }
  .ukbt-404__links h2 {
    margin: 0 0 var(--ukbt-space-3) 0;
  }
  .ukbt-404__links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ukbt-space-2) var(--ukbt-space-4);
  }
  /* Not brand-accent gold: that color is only ever contrast-safe on the
     dark inverse surface (see FranchiseTeaser.astro's F3 fix comment).
     This section sits on the default light surface, so it needs a dark
     link color instead â€” measured by the same mobile axe-core sweep
     that caught the heading-order gaps. */
  .ukbt-404__links a {
    color: var(--ukbt-color-surface-inverse);
    text-decoration: underline;
  }
</style>
