---
// Club Captain page — the one full player profile actually evidenced
// (artifacts/content/UKBT-CONTENT-INVENTORY.md C-003/C-005/C-006/C-007/
// C-008). No Adelux template page maps to a player-stats profile, so
// ProfileHeader/StatsTable are UKBT-original (see their own comments).
// Stats-provider platform names are evidenced; their profile URLs are
// client-supplied (see captain-data.ts) and rendered as external links.
// Personal-social profile URLs are client-supplied (see captain-data.ts)
// and rendered as external links the same way.
// PageBanner carries the page h1; ProfileHeader's name renders as h2.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import FranchiseTimeline from '../components/FranchiseTimeline.astro';
import Button from '../components/Button.astro';
import StatsTable from '../components/StatsTable.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { captain, captainPhoto } from '../content/captain-data';
import { captainGraph } from '../lib/seo';
import Link from '../components/Link.astro';
import SubHeading from '../components/SubHeading.astro';

const profileFacts = [
  { label: 'Date of Birth', value: captain.dob },
  { label: 'Nationality', value: captain.nationality },
  { label: 'Batting Style', value: captain.battingStyle },
  { label: 'Bowling Style', value: captain.bowlingStyle },
];

const battingHeaders = ['Format', 'M', 'Inn', 'Runs', 'HS', 'Avg', 'SR', '100s', '50s'];
const battingRows = captain.battingStats.map((s) => [
  s.format,
  s.matches,
  s.innings,
  s.runs,
  s.highScore,
  s.average,
  s.strikeRate,
  s.hundreds,
  s.fifties,
]);

const bowlingHeaders = ['Format', 'Overs', 'Wkts', 'Avg', 'Econ', 'Best'];
const bowlingRows = captain.bowlingStats.map((s) => [
  s.format,
  s.overs,
  s.wickets,
  s.average,
  s.economy,
  s.best,
]);

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Club Captain' }];
// Captain banner backdrop (owner direction 2026-09-11): gallery-05,
// owner-confirmed UKBT award-presentation photo (no prior EV finding
// for this file — new owner-supplied drop, see MANIFEST). 1400x933,
// 56KB. Photo is presentation wiring, not a gated fact.
const bannerBackground = {
  src: '/media/gallery-05.webp',
  alt: 'UK Bangla Tigers player receiving an award plaque',
  width: 1400,
  height: 933,
  // Faces sit at y≈13–37%: bias the cover crop upward so both survive
  // at wide slots; narrow slots barely crop horizontally either way.
  focus: '50% 20%',
};
// Identity line removed (owner direction 2026-09-12): the nationality
// already appears in the facts table below — no duplicate line needed.
const identityLine: string | undefined = undefined;
// ProfilePage+Person graph via the central SEO emitter — gated name/role
// only (see src/lib/seo.ts).
const structuredData = captainGraph({
  name: captain.name,
  role: captain.role,
  photo: captainPhoto,
  crumbs,
});
---

<BaseLayout
  title="Club Captain — UK Bangla Tigers"
  description={`${captain.name}, ${captain.role}`}
  structuredData={structuredData}
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner title="Club Captain" crumbs={crumbs} background={bannerBackground} />

    <Section>
      <ProfileHeader
        name={captain.name}
        role={captain.role}
        facts={profileFacts}
        photo={captainPhoto}
        layout="athlete"
        identityLine={identityLine}
        showEyebrow={false}
      />
    </Section>

    <Section surface="alt">
      <div class="ukbt-captain-section-eyebrow"><SubHeading label="Career Path" /></div>
      <h2>Franchise History</h2>
      <FranchiseTimeline current={captain.currentFranchises} previous={captain.previousFranchises} />
    </Section>

    <Section>
      <div class="ukbt-captain-section-eyebrow"><SubHeading label="Performance" /></div>
      <h2>Career Statistics</h2>
      <div class="ukbt-stats-stack">
        <StatsTable caption="Batting" headers={battingHeaders} rows={battingRows} />
        <StatsTable caption="Bowling" headers={bowlingHeaders} rows={bowlingRows} />
      </div>
    </Section>

    <Section surface="alt">
      <div class="ukbt-links-grid">
        <div>
          <h3>Stats Also Tracked On</h3>
          <ul class="ukbt-plain-list">
            {captain.statsProviders.map((p) => (
              <li><Link href={p.url} external underline="always">{p.name}</Link></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Follow {captain.name}</h3>
          <ul class="ukbt-plain-list">
            {captain.personalSocialPlatforms.map((p) => (
              <li><Link href={p.url} external underline="always">{p.name}</Link></li>
            ))}
          </ul>
        </div>
      </div>
    </Section>

    <Section>
      <div class="ukbt-captain-close">
        <Button label="Back to Players" href="/players/" variant="secondary" />
      </div>
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  /* Both section h2s carry a SubHeading eyebrow (C1), so the eyebrow gap
     lives here once instead of a separate wrapper rule. The athlete
     name keeps its own margin via its higher-specificity class rule. */
  h2 {
    margin: var(--ukbt-space-2) 0 var(--ukbt-space-gap-5) 0;
  }
  h3 {
    margin: 0 0 var(--ukbt-space-gap-2) 0;
  }
  .ukbt-stats-stack {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-8);
  }
  .ukbt-captain-close {
    display: flex;
    justify-content: flex-start;
    /* C3: deliberate terminal — gold top rule in the existing boundary
       grammar (AboutCTA, FranchiseTeaser), no new content or CTA. */
    border-top: 3px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-6);
  }
  .ukbt-links-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ukbt-space-8);
  }
  .ukbt-plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-2);
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
  @media screen and (max-width: 767px) {
    .ukbt-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
