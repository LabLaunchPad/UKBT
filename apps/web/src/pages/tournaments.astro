---
// International Tournaments/Events page â€” the full evidenced calendar
// (2 upcoming, 3 completed). Uses the reference's dark-card/pill-tag
// visual language (already established via TournamentCard.astro) in a
// simple grid, since Adelux's own event.html grammar (main-event + CTA +
// two-small) doesn't fit a full calendar listing without a fabricated
// "featured" event.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import TournamentCard from '../components/TournamentCard.astro';
import Footer from '../components/Footer.astro';
import FranchiseTeaser from '../components/FranchiseTeaser.astro';
import { homepage } from '../content/homepage-data';
import { completedTournaments, upcomingTournaments } from '../content/tournaments-data';
// Events banner backdrop (owner direction 2026-09-11): gallery-10,
// owner-confirmed UKBT squad photo (no prior EV finding for this file
// — new owner-supplied drop, see MANIFEST). 1400x1002, 230KB.
// Photo is presentation wiring, not a gated fact.
const bannerBackground = {
  src: '/media/gallery-10.webp',
  alt: 'UK Bangla Tigers squad celebrating a cup win with medals and trophy',
  width: 1400,
  height: 1002,
};
---

<BaseLayout
  title="International Tournaments and Events — UK Bangla Tigers"
  description="UK Bangla Tigers' international tournament calendar."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner
      title="Events"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Events' }]}
      background={bannerBackground}
    />

    <Section>
      <h2 id="upcoming">Upcoming</h2>
      <div class="ukbt-events-grid">
        {upcomingTournaments.map((t) => <TournamentCard {...t} />)}
      </div>
    </Section>

    <Section surface="alt" paddingBottom="normal">
      <h2 id="completed">Completed</h2>
      <div class="ukbt-events-grid">
        {completedTournaments.map((t) => <TournamentCard {...t} />)}
      </div>
    </Section>

    <Section>
      <FranchiseTeaser name={homepage.sisterFranchise} />
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  h2 {
    margin: 0 0 var(--ukbt-space-gap-5) 0;
  }
  .ukbt-events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ukbt-space-6);
  }
  @media screen and (max-width: 1025px) {
    .ukbt-events-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media screen and (max-width: 767px) {
    .ukbt-events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
