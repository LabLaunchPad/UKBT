---
// UK Bangla Tigers homepage. Content is bound to @ukbt/truth's gate
// (src/content/homepage-data.ts), not hard-coded past the truth
// architecture. Each section mirrors the reference's actual measured
// layout — see per-component comments. No Adelux code, content, or
// branding appears anywhere below.
//
// Section order follows the reference homepage's own sequence, with the
// sections that have no UKBT counterpart omitted rather than filled:
//   Banner → About → Why Choose Us → Academy → Tournament → Captain
//   → Community → CTA → Footer
// This expands HOMEPAGE-CONTRACT.md's originally-frozen 8-section
// structure under the client's later, explicit template-parity direction
// (CLIENT_REQ_009-012, EV-20260826-032) — see HOMEPAGE-CONTRACT.md
// Amendment 01, which records that authority rather than leaving the
// expansion undocumented (Stage 8 red team F2).
//
// Testimonial and News are deliberately NOT included here, even though
// components exist for them: both are structural shells with
// CONTENT_STATUS = UNKNOWN (no consented member quote, no club article
// exists in evidence), and shipping a visibly-empty "not published yet"
// box on the site's primary indexed route is a worse outcome than
// omitting the section until real content exists (Stage 8 red team F2).
// They remain available as components for lower-traffic pages.
// The reference's Service and Padel Booking sections describe a
// court-booking business and have no UKBT equivalent at all.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ClubIntro from '../components/ClubIntro.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import AcademySection from '../components/AcademySection.astro';
import TournamentGrid from '../components/TournamentGrid.astro';
import CaptainSpotlight from '../components/CaptainSpotlight.astro';
import FranchiseTeaser from '../components/FranchiseTeaser.astro';
import AboutCTA from '../components/AboutCTA.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { homepage } from '../content/homepage-data';
import { homepageGraph } from '../lib/seo';
import { tinaHomepage } from '../lib/tina/loaders';
import homepageData from '../../content/homepage/homepage.json' with { type: 'json' };

const [mainEvent, ...otherEvents] = homepage.upcomingTournaments;

// WhyChooseUs reasons from Tina CMS — client can edit these via admin.
// Static JSON carries no _content_source by design; markers populate on
// bridge island re-render, where reasons come from the fetched Tina doc.
const reasons = tinaHomepage.whyChooseUs.map((r: { title: string; body: string }) => ({
  title: r.title,
  body: r.body,
}));

const academyCounters = [
  { value: homepage.stats.players, label: 'Players across the squad' },
  { value: homepage.stats.countries, label: 'Countries internationals' },
  { value: homepage.stats.tournaments, label: 'International tournaments' },
];

// Organization graph via the central SEO emitter — same gated vars,
// single graph shape (see src/lib/seo.ts).
const structuredData = homepageGraph({
  founded: homepage.founded,
  description: homepage.taglineShort,
  sameAs: homepage.social.map((s) => s.url),
});
---

<BaseLayout
  title="UK Bangla Tigers — Cricket Club"
  description={tinaHomepage.metaDescription || homepage.taglineShort}
  structuredData={structuredData}
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    {/*
      Visual editing (official @tinacms/astro static-site flow): the
      hero and club-intro regions are wrapped in registered TinaIslands.
      The wrapper emits a one-line inline bootstrap (hashed into the CSP
      by scripts/stamp-csp.mjs) that loads /admin/bridge.js only inside
      the admin iframe; the bridge primes /tina-island/hero and
      /tina-island/aboutSection to pick up form payloads, and every
      editor keystroke re-POSTs the island for a live swap. `primary`
      makes the admin open the hero form on load. The wrapper tags match
      the island registry (src/lib/tina/islands.ts) exactly — the bridge
      swaps the whole wrapper element.
    */}
    <TinaIsland name="hero" wrapper={{ tag: 'div', className: 'ukbt-hero-island' }} primary>
      <Hero
        taglineShort={homepage.taglineShort}
        tagline={tinaHomepage.tagline}
        social={homepage.social}
        eyebrow={tinaHomepage.eyebrow || 'UK Bangla Tigers Cricket Club'}
        headline={tinaHomepage.headline}
        primaryCtaLabel={tinaHomepage.primaryCtaLabel}
        primaryCtaLink={tinaHomepage.primaryCtaLink}
        secondaryCta={tinaHomepage.secondaryCtaLabel ? { label: tinaHomepage.secondaryCtaLabel, href: tinaHomepage.secondaryCtaLink || '/tournaments/' } : undefined}
        heroImage={tinaHomepage.heroImage}
        data={homepageData}
      />
    </TinaIsland>

    <Section>
      <TinaIsland name="aboutSection" wrapper={{ tag: 'div', className: 'ukbt-club-intro-island' }}>
        <ClubIntro lede={tinaHomepage.clubIntroLede} founded={homepage.founded} data={homepageData} />
      </TinaIsland>
    </Section>

    <Section surface="alt" wrapper={true}>
      <TinaIsland name="whyChooseUs" wrapper={{ tag: 'div', className: 'ukbt-chooseus' }}>
        <WhyChooseUs reasons={reasons} variant="editorial" />
      </TinaIsland>
    </Section>

    <Section surface="inverse" wrapper={true}>
      <AcademySection tagline={homepage.tagline} counters={academyCounters} />
    </Section>

    <Section>
      <SectionHeader
        eyebrow="Upcoming Tournament"
        heading="Join Us on the International Stage"
        ctaLabel="All tournaments"
        ctaHref="/tournaments/"
      />
      <TournamentGrid mainEvent={mainEvent} otherEvents={otherEvents} />
    </Section>

    <Section surface="alt">
      <CaptainSpotlight
        name={homepage.captain.name}
        role={homepage.captain.role}
        photo={homepage.captain.photo}
        density="editorial"
        ctaLabel="View full profile"
      />
    </Section>

    <Section>
      <FranchiseTeaser name={homepage.sisterFranchise} />
    </Section>

    <Section surface="alt" paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>