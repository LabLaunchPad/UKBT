---
// Community page â€” mirrors the reference's `community.html` sequence
// (Banner â†’ Tournament â†’ Academy â†’ Testimonial â†’ Community â†’ CTA).
// Route added under CLIENT_REQ_009 / ROUTE-CONTRACT Amendment 01.
//
// Real content throughout except the Testimonial shell: the club's
// franchise network, tournament calendar and learning-institute
// self-description are all on record.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AcademySection from '../components/AcademySection.astro';
import FranchiseTeaser from '../components/FranchiseTeaser.astro';
import AboutCTA from '../components/AboutCTA.astro';
import TournamentCard from '../components/TournamentCard.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { upcomingTournaments } from '../content/tournaments-data';

const academyCounters = [
  { value: homepage.stats.players, label: 'Players across the squad' },
  { value: homepage.stats.countries, label: 'Countries internationals' },
  { value: homepage.stats.tournaments, label: 'International tournaments' },
];
---

<BaseLayout
  title="Community â€” UK Bangla Tigers"
  description="The UK Bangla Tigers community, across two nations."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />
  <main id="main-content" tabindex="-1">
    <PageBanner title="Community" crumbs={[{ label: 'Home', href: '/' }, { label: 'Community' }]} />

    <Section>
      <SectionHeader
        eyebrow="Upcoming"
        heading="Where the Tigers Play Next"
        ctaLabel="All tournaments"
        ctaHref="/tournaments"
      />
      <div class="ukbt-community-events">
        {upcomingTournaments.map((t) => <TournamentCard {...t} />)}
      </div>
    </Section>

    <Section surface="inverse" wrapper={true}>
      <AcademySection tagline={homepage.tagline} counters={academyCounters} />
    </Section>

    <Section>
      <FranchiseTeaser name={homepage.sisterFranchise} />
    </Section>

    <!-- TestimonialSection omitted: no real testimonials exist yet -->

    <Section paddingBottom="normal">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>
  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  .ukbt-community-events {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ukbt-space-gap-2);
  }
  @media screen and (max-width: 767px) {
    .ukbt-community-events {
      grid-template-columns: 1fr;
    }
  }
</style>
