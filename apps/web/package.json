    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@tinacms/cli": "^3.0.0",
