{
  // Worker + static-assets deployment target for @ukbt/web.
  // See contracts/DEPLOYMENT-CONTRACT.md's 2026-08-27 amendment: HOST is
  // Cloudflare Workers (static assets), not Cloudflare Pages as originally
  // frozen — the owner connected this exact pre-provisioned Worker via the
  // Cloudflare dashboard's "Connect to a repository" flow on that date.
  //
  // AT REPOSITORY ROOT, deliberately, not in apps/web/. Cloudflare Workers
  // Builds runs its deploy command from the configured Root directory
  // ("/"), and wrangler looks for its config in the directory it runs
  // from. A config under apps/web/ is only found via an explicit
  // `-c apps/web/wrangler.jsonc` flag, which the dashboard's DEFAULT
  // deploy command does not pass — the real, logged cause of build
  // 55c1d854's "Missing entry-point to Worker script or to assets
  // directory". Keeping it here means `npx wrangler deploy` and
  // `npx wrangler versions upload` both work unmodified.
  //
  // 2026-09-15 (production 404 recovery): `@astrojs/cloudflare` IS active
  // (apps/web/astro.config.mjs `adapter: cloudflare()`, Astro `output:
  // 'static'`). The adapter relocates static output to `dist/client/` and
  // emits the Worker entry at `dist/server/entry.mjs` — verified against a
  // clean local build, which also yields the adapter-generated
  // `dist/server/wrangler.json` (`main: "entry.mjs"`, assets `"../client"`,
  // relative to `dist/server/`). This root config mirrors that generated
  // truth with paths relative to the repository root. The previous
  // assets-only revision (`assets.directory: ./apps/web/dist`, no `main`)
  // served a directory containing only `client/` + `server/` subfolders —
  // no `index.html`, no `404.html`, no `_headers` at its root — so every
  // route 404'd at the platform layer. `main` is required because exactly
  // one production route is on-demand: `tina-island/[name].ts`
  // (`export const prerender = false`, POST island handler); all other
  // routes are prerendered and served as static assets. `name` keeps the
  // dashboard Worker's exact name (`ukbt-uk-bangla-tigers`); the adapter-
  // generated `ukbt-web` name must NOT be adopted.
  "name": "ukbt-uk-bangla-tigers",
  "compatibility_date": "2026-09-14",
  "main": "./apps/web/dist/server/entry.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/web/dist/client",
    "not_found_handling": "404-page"
  },
  // Mirrors the dashboard's current Observability settings for this Worker
  // (Settings > Observability), so `wrangler deploy`/`versions upload` from
  // CI don't silently reset them to defaults on the next deploy. Logs are
  // on; the top-level `enabled: false` and `traces.enabled: false` disable
  // the (separate, paid) Workers Logs/Traces *analytics engine* pipeline,
  // not `logs` itself.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    // 2026-09-11 (P0/P1 hardening, F-06): redact query strings from
    // persisted invocation logs. Verified safe — the static site has no
    // query-string-dependent runtime behavior (no forms, no search, no
    // URLSearchParams/location.search anywhere in apps/web/src, no
    // query-bearing redirects or analytics). See
    // docs/security/query-log-redaction.md.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
